(ns tests.basilisp.data-xml-test
  (:import io)
  (:require [basilisp.test :refer [deftest is]]
            [clojure.data.xml :as xml]
            [clojure.data.xml.event :as event]
            [clojure.data.xml.tree :as tree]
            [clojure.test.check :as tc]
            [clojure.test.check.generators :as gen]
            [clojure.test.check.properties :as prop]))

(deftest qnames-and-tree-elements-preserve-namespace-meaning
  (let [tag (xml/qname "urn:example:catalog" "book")]
    (is (= "urn:example:catalog" (xml/qname-uri tag)))
    (is (= "book" (xml/qname-local tag)))
    (is (xml/namespaced? tag))
    (is (= tag (xml/as-qname tag)))
    (is (= "urn:example:catalog" (xml/symbol-uri (xml/uri-symbol "urn:example:catalog"))))
    (is (= "xmlns.urn+space" (str (xml/uri-symbol "urn space"))))
    (is (= "urn space" (xml/symbol-uri (xml/uri-symbol "urn space"))))
    (is (= "xmlns/urn+space.cljc" (xml/uri-file "urn space")))
    (is (= (xml/qname "urn:example:catalog" "book")
           (xml/parse-qname "{urn:example:catalog}book")))
    (is (= "urn:example:catalog" (xml/qname-uri "{urn:example:catalog}book")))
    (is (= "book" (xml/qname-local "{urn:example:catalog}book"))))
  (let [tree (xml/parse-str "<root xmlns='urn:example'><child a='1'>text</child></root>")]
    (is (= "urn:example" (xml/qname-uri (:tag tree))))
    (is (= "root" (xml/qname-local (:tag tree))))
    (is (= "urn:example" (xml/qname-uri (:tag (first (:content tree))))))
    (is (= "1" (get (:attrs (first (:content tree))) :a)))
    (is (re-find #"urn:example" (xml/emit-str tree)))))

(deftest emit-parse-prxml-and-indentation-contracts
  (let [tree (xml/sexp-as-element [:root {:answer 42} [:child "hello"]])
        emitted (xml/emit-str tree)
        writer (io/StringIO)]
    (is (xml/element? tree))
    (is (= {:tag :root :attrs {:answer "42"}
            :content [{:tag :child :content ["hello"]}]}
           (xml/parse-str emitted)))
    (xml/emit tree writer :declaration false)
    (is (= "<root answer=\"42\"><child>hello</child></root>" (.getvalue writer)))
    (is (re-find #"\n  <child>" (xml/indent-str tree)))
    (is (= "<root><![CDATA[a < b]]></root>"
           (xml/emit-str (xml/element :root nil (xml/cdata "a < b")) :declaration false)))
    (let [prxml (xml/sexp-as-element [:root [:child] "tail"])]
      (is (= :root (:tag prxml)))
      (is (= :child (:tag (first (:content prxml)))))
      (is (= "tail" (second (:content prxml)))))
    (is (thrown? Exception (xml/sexp-as-element [[:a] [:b]])))))

(deftest element-star-and-namespace-helpers-match-data-xml-contracts
  (let [el (xml/element* :root nil [nil "x"] {:m true})
        raw-el (xml/element* :root nil [] {:clojure.data.xml/nss {"q" "urn:q"}})
        xmlns-el (xml/element* :root
                               {:xmlns/p "urn:p"
                                (xml/qname "urn:attr" "id") "7"}
                               [])
        nss (xml/element-nss xmlns-el)
        aggregate (xml/aggregate-xmlns
                   (xml/element :root nil
                                (xml/element (xml/qname "urn:child" "node")
                                             {(xml/qname "urn:attr" "id") "1"})))]
    (is (= {:tag :root :content ["x"]} el))
    (is (= {:m true} (meta el)))
    (is (= {"q" "urn:q"} (event/element-nss* raw-el)))
    (is (= "urn:p" (get-in nss [:p->u "p"])))
    (is (= "http://www.w3.org/XML/1998/namespace" (get-in nss [:p->u "xml"])))
    (is (= "http://www.w3.org/2000/xmlns/" (get-in nss [:p->u "xmlns"])))
    (is (= #{"" "http://www.w3.org/2000/xmlns/" "urn:attr"}
           (set (xml/find-xmlns xmlns-el))))
    (is (contains? (set (keys (:u->ps (event/element-nss* aggregate)))) "urn:child"))
    (is (contains? (set (keys (:u->ps (event/element-nss* aggregate)))) "urn:attr"))))

(deftest parser-rejects-expansion-input-and-respects-options
  (is (thrown? python/ValueError
               (xml/parse-str "<!DOCTYPE root [<!ENTITY bomb 'x'>]><root>&bomb;</root>")))
  (is (thrown? python/ValueError (xml/parse-str "<x/>" :max-chars 1)))
  (is (= {:tag :root :content ["x"]}
         (xml/parse (io/StringIO "<root>x</root>"))))
  (is (= {:tag :root :content ["x" {:tag :child}]}
         (xml/parse-str "<root>x<!-- hidden --><child/></root>")))
  (let [tree (xml/parse-str "<root>x<!-- shown --><child/></root>"
                            :include-node? #{:element :characters :comment})]
    (is (= :root (:tag tree)))
    (is (= "x" (first (:content tree))))
    (is (= " shown " (.-content (second (:content tree)))))
    (is (= :child (:tag (last (:content tree)))))))

(deftest event-seq-streams-data-xml-records-and-tree-helpers
  (let [events (vec (xml/event-seq "<root a='1'>x<empty/><child><![CDATA[y < z]]></child></root>"))
        [root chars empty child cdata child-exit root-exit] events]
    (is (= 7 (count events)))
    (is (instance? xml/StartElementEvent root))
    (is (instance? event/StartElementEvent root))
    (is (= :root (.-tag root)))
    (is (= "1" (get (.-attrs root) :a)))
    (is (= "x" (.-str chars)))
    (is (instance? xml/EmptyElementEvent empty))
    (is (= :empty (.-tag empty)))
    (is (= :child (.-tag child)))
    (is (instance? xml/CharsEvent cdata))
    (is (= "y < z" (.-str cdata)))
    (is (event/event-exit? child-exit))
    (is (= :child (.-tag child-exit)))
    (is (xml/event-exit? root-exit))
    (is (= "x" (xml/event-node chars)))
    (is (= "y < z" (xml/event-node cdata)))
    (is (= {:tag :root :attrs {:a "1"}}
           (xml/event-element root))))
  (let [events (vec (xml/event-seq "<root><![CDATA[y < z]]></root>"
                                   :coalescing false))]
    (is (instance? xml/CDataEvent (second events)))
    (is (= (xml/cdata "y < z") (xml/event-node (second events))))))

(deftest map-event-constructors-and-end-events-match-public-record-shapes
  (let [start (event/map->StartElementEvent {:tag :root
                                             :attrs {:a "1"}
                                             :nss {}
                                             :location-info nil})
        empty (event/map->EmptyElementEvent {:tag :empty
                                             :attrs {}
                                             :nss {}
                                             :location-info nil})
        chars (event/map->CharsEvent {:str "x"})
        cdata (event/map->CDataEvent {:str "y"})
        comment (event/map->CommentEvent {:str " note "})
        qn (event/map->QNameEvent {:qn :name})
        end (event/map->EndElementEvent {:tag :root
                                         :nss {}
                                         :location-info nil})]
    (is (= :root (.-tag start)))
    (is (= :empty (.-tag empty)))
    (is (= "x" (.-str chars)))
    (is (= "y" (.-str cdata)))
    (is (= " note " (.-str comment)))
    (is (= :name (.-qn qn)))
    (is (= :root (.-tag end)))
    (is (event/event-exit? end))
    (is (event/event-exit? (xml/->EndElementEvent)))))

(deftest event-seq-options-and-security-match-tree-parsing
  (let [without-comments (vec (xml/event-seq "<root><!-- hidden --></root>"))
        with-comments (vec (xml/event-seq "<root><!-- shown --></root>"
                                         :include-node? #{:element :characters :comment}))]
    ;; A suppressed comment still makes the lexical element non-empty.
    (is (instance? xml/StartElementEvent (first without-comments)))
    (is (xml/event-exit? (second without-comments)))
    (is (instance? xml/CommentEvent (second with-comments)))
    (is (= " shown " (.-str (second with-comments))))
    (is (= (xml/xml-comment " shown ") (xml/event-node (second with-comments)))))
  (is (thrown? python/ValueError
               (doall (xml/event-seq "<!DOCTYPE root [<!ENTITY bomb 'x'>]><root>&bomb;</root>"))))
  (is (thrown? python/ValueError (doall (xml/event-seq "<root/>" :max-chars 1))))
  (is (thrown? python/ValueError (xml/event-node (xml/->EndElementEvent))))
  (is (thrown? python/ValueError (xml/event-element (xml/->CharsEvent "x")))))

(deftest event-tree-and-flatten-elements-roundtrip-all-supported-node-kinds
  (let [source (xml/element :root {:enabled "true"}
                            (xml/element :child {:n "1"} "text")
                            (xml/cdata "a < b")
                            (xml/xml-comment " note "))
        events (vec (xml/flatten-elements [source]))
        rebuilt (xml/event-tree events)]
    (is (= source rebuilt))
    (is (instance? xml/StartElementEvent (first events)))
    (is (instance? xml/CDataEvent (nth events 4)))
    (is (instance? xml/CommentEvent (nth events 5)))
    (is (xml/event-exit? (last events)))
    (is (= :root (.-tag (last events))))
    (is (= "http://www.w3.org/XML/1998/namespace"
           (get-in (event/element-nss source) [:p->u "xml"])))
    (is (= "http://www.w3.org/2000/xmlns/"
           (get-in (event/element-nss source) [:p->u "xmlns"]))))
  (let [events (vec (xml/flatten-elements [nil true false 42 :name]))]
    (is (= ["" "true" "false" "42"]
           (mapv #(.-str %) (take 4 events))))
    (is (= :name (.-qn (last events)))))
  (let [generic (tree/seq-tree (fn [value children]
                                 (when (= :open value) [children]))
                               #{:close} str
                               [:open 1 :close :after :close :rest])]
    (is (= "1" (first (first (first (first generic))))))
    (is (= ":after" (second (first generic))))
    (is (= :rest (first (rest generic))))))

(deftest seeded-tree-roundtrips-never-drop-content-or-attributes
  (let [property
        (prop/for-all [value (gen/vector (gen/choose 0 1000000) 1 8)]
          (let [children (mapv #(xml/element :item {:n (str %)} (str %)) value)
                tree (apply xml/element :root {:count (str (count value))} children)
                parsed (xml/parse-str (xml/emit-str tree))]
            (= tree parsed)))
        result (tc/quick-check 300 property :seed 20260724 :max-size 30)]
    (is (:pass? result))
    (is (= 300 (:num-tests result)))))

(deftest seeded-event-streams-preserve-all-character-content
  (let [property
        (prop/for-all [values (gen/vector (gen/choose 0 1000000) 0 10)]
          (let [source (str "<root>"
                            (apply str (map #(str "<n>" % "</n>") values))
                            "</root>")
                events (vec (xml/event-seq source))
                chars (mapv #(.-str %)
                            (filter #(instance? xml/CharsEvent %) events))]
            (= (mapv str values) chars)))
        result (tc/quick-check 250 property :seed 20260726 :max-size 20)]
    (is (:pass? result))
    (is (= 250 (:num-tests result)))))

(deftest seeded-flatten-event-tree-roundtrips-never-drop-mixed-content
  (let [property
        (prop/for-all [values (gen/vector (gen/choose 0 1000000) 0 8)]
          (let [children (mapv #(xml/element :item {:n (str %)}
                                             (str %) (xml/cdata (str "c" %))) values)
                source (apply xml/element :root {:count (str (count values))} children)]
            (= source (xml/event-tree (xml/flatten-elements [source])))))
        result (tc/quick-check 250 property :seed 20260727 :max-size 20)]
    (is (:pass? result))
    (is (= 250 (:num-tests result)))))
