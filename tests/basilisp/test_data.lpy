(ns tests.basilisp.test-data
  (:import datetime)
  (:require
   [basilisp.data :as data :refer [diff]]
   [basilisp.test :refer [deftest are is testing]]
   [clojure.test.check :as tc]
   [clojure.test.check.generators :as gen]
   [clojure.test.check.properties :as prop]))

(defrecord Pair [a b])

(deftest public-surface-and-protocol-methods-test
  (let [publics (set (map name (keys (ns-publics 'basilisp.data))))]
    (are [public-name] (contains? publics public-name)
      "Diff"
      "EqualityPartition"
      "diff"
      "diff-similar"
      "equality-partition"))
  (are [value partition] (= partition (data/equality-partition value))
    nil    :atom
    1      :atom
    "ab"   :atom
    [1 2]  :sequential
    '(1 2) :sequential
    {:a 1} :map
    #{1}   :set)
  (are [a b expected] (= expected (data/diff-similar a b))
    1     2     [1 2 nil]
    [1 2] [1 3] [[nil 2] [nil 3] [1]]
    #{1 2} #{2 3} [#{1} #{3} #{2}])
  (are [a b expected] (= expected (data/diff a b))
    {:a nil} {:a 1}        '({:a nil} {:a 1} nil)
    {:a 1}   {:a nil}      '({:a 1} {:a nil} nil)
    {:a nil} {:a nil :b 1} '(nil {:b 1} {:a nil})
    [nil 1]  [nil 2]       [[nil 1] [nil 2] [nil]]
    [1 nil]  [2 nil]       [[1] [2] [nil nil]]
    []       [nil]         [nil [nil] nil]
    [nil]    []            [[nil] nil nil])
  (testing "map diff-similar keeps Clojure's seq result shape"
    (let [result (data/diff-similar {:a 1} {:a 2})]
      (are [expected] (= expected result)
        '({:a 1} {:a 2} nil))
      (are [predicate] (predicate result)
        seq?))))

(deftest diff-test
  (testing "scalar types"
    (testing "no diff if equal"
      (are [x] (= [nil nil x] (diff x x))
        ""
        "string"
        -1
        0
        1
        -1.0
        0.0
        1.0
        true
        false
        nil

        :kw
        :ns/kw
        'sym
        'ns/sym

        #inst "2020-06-04T22:32:29.871744"
        (datetime/date 2020 6 4)
        (datetime/time 22 35 38)
        3.1415926535M
        22/7
        #uuid "632ac3d8-fcfd-4d36-a05b-a54277a345bc"))

    (testing "completely different if not equal"
      (are [x y] (= [x y nil] (diff x y))
        ""       "not empty"
        "string" "not a string"
        -1       -9327
        0        3
        1        1373
        -1.0     -71.183
        0.0      1.373
        1.0      43727272.3
        true     false
        false    true
        nil      :not-nil

        :kw     :other-kw
        :ns/kw  :other-ns/kw
        'sym    'other-sym
        'ns/sym 'other-ns/sym

        #inst "2020-06-04T22:32:29.871744"           #inst "2019-01-03T11:15:30.871744"
        (datetime/date 2020 6 4)                     (datetime/time 22 35 38)
        (datetime/time 22 35 38)                     (datetime/date 2020 6 4)
        3.1415926535M                                2.7182818284M
        22/7                                         1/2
        #uuid "632ac3d8-fcfd-4d36-a05b-a54277a345bc" #uuid "33fef9e5-071c-47e6-886c-f8790bf1d07d")))

  (testing "set types"
    (testing "set types never equal to non-set type"
      (are [x] (= [#{} x nil] (diff #{} x))
        ""
        "string"
        -1
        0
        1
        -1.0
        0.0
        1.0
        true
        false
        nil

        :kw
        :ns/kw
        'sym
        'ns/sym

        #inst "2020-06-04T22:32:29.871744"
        (datetime/date 2020 6 4)
        (datetime/time 22 35 38)
        3.1415926535M
        22/7
        #uuid "632ac3d8-fcfd-4d36-a05b-a54277a345bc"

        {}
        []
        '()))

    (testing "Basilisp set"
      (are [x y z] (= z (diff x y))
        #{}      #{}      [nil nil #{}]
        #{:a}    #{:a}    [nil nil #{:a}]
        #{:a}    #{:b}    [#{:a} #{:b} nil]
        #{:a :b} #{:b :c} [#{:a} #{:c} #{:b}]

        ;; no subdiffs
        #{:a [:b :c]}     #{:a [:c :d]}     [#{[:b :c]} #{[:c :d]} #{:a}]
        #{:a '(:b :c)}    #{:a '(:c :d)}    [#{'(:b :c)} #{'(:c :d)} #{:a}]
        #{:a #{:b :c}}    #{:a #{:c :d}}    [#{#{:b :c}} #{#{:c :d}} #{:a}]
        #{:a {:b 2 :c 3}} #{:a {:c 3 :d 4}} [#{{:b 2 :c 3}} #{{:c 3 :d 4}} #{:a}]))

    (testing "mutable Python set"
      (are [x y z] (= z (diff (python/set x) (python/set y)))
        []      []      [nil nil #{}]
        [:a]    [:a]    [nil nil #{:a}]
        [:a]    [:b]    [#{:a} #{:b} nil]
        [:a :b] [:b :c] [#{:a} #{:c} #{:b}]

        ;; no subdiffs
        [:a [:b :c]]     [:a [:c :d]]     [#{[:b :c]} #{[:c :d]} #{:a}]
        [:a '(:b :c)]    [:a '(:c :d)]    [#{'(:b :c)} #{'(:c :d)} #{:a}]
        [:a #{:b :c}]    [:a #{:c :d}]    [#{#{:b :c}} #{#{:c :d}} #{:a}]
        [:a {:b 2 :c 3}] [:a {:c 3 :d 4}] [#{{:b 2 :c 3}} #{{:c 3 :d 4}} #{:a}]))

    (testing "Python frozenset"
      (are [x y z] (= z (diff (python/frozenset x) (python/frozenset y)))
        []      []      [nil nil #{}]
        [:a]    [:a]    [nil nil #{:a}]
        [:a]    [:b]    [#{:a} #{:b} nil]
        [:a :b] [:b :c] [#{:a} #{:c} #{:b}]

        ;; no subdiffs
        [:a [:b :c]]     [:a [:c :d]]     [#{[:b :c]} #{[:c :d]} #{:a}]
        [:a '(:b :c)]    [:a '(:c :d)]    [#{'(:b :c)} #{'(:c :d)} #{:a}]
        [:a #{:b :c}]    [:a #{:c :d}]    [#{#{:b :c}} #{#{:c :d}} #{:a}]
        [:a {:b 2 :c 3}] [:a {:c 3 :d 4}] [#{{:b 2 :c 3}} #{{:c 3 :d 4}} #{:a}])))

  (testing "sequential types"
    (testing "vector types never equal to non-sequential type"
      (are [x] (= [[] x nil] (diff [] x))
        ""
        "string"
        -1
        0
        1
        -1.0
        0.0
        1.0
        true
        false
        nil

        :kw
        :ns/kw
        'sym
        'ns/sym

        #inst "2020-06-04T22:32:29.871744"
        (datetime/date 2020 6 4)
        (datetime/time 22 35 38)
        3.1415926535M
        22/7
        #uuid "632ac3d8-fcfd-4d36-a05b-a54277a345bc"

        {}
        {:a 1}
        #{}
        #{:a :b :c}))

    (testing "list types never equal to non-sequential type"
      (are [x] (= ['() x nil] (diff '() x))
        ""
        "string"
        -1
        0
        1
        -1.0
        0.0
        1.0
        true
        false
        nil

        :kw
        :ns/kw
        'sym
        'ns/sym

        #inst "2020-06-04T22:32:29.871744"
        (datetime/date 2020 6 4)
        (datetime/time 22 35 38)
        3.1415926535M
        22/7
        #uuid "632ac3d8-fcfd-4d36-a05b-a54277a345bc"

        {}
        {:a 1}
        #{}
        #{:a :b :c}))

    (testing "sequential types equal"
      (are [x y z] (= z (diff x y))
        []                []                  [nil nil []]
        [1 2 3]           [2 3 4]             [[1 2 3] [2 3 4] nil]
        [1 2 3]           [1 2 4]             [[nil nil 3] [nil nil 4] [1 2]]
        [1 2 3]           [1 2 3]             [nil nil [1 2 3]]
        [1 2 3]           [1 2 3 4]           [nil [nil nil nil 4] [1 2 3]]
        [1 2 3]           [5 9 3 2 3 7]       [[1 2] [5 9 nil 2 3 7] [nil nil 3]]
        [{:a 1 :b 2} 2 3] [{:a 1 :b 3} 0 3]   [[{:b 2} 2] [{:b 3} 0] [{:a 1} nil 3]]
        [1 #{:a :b :c} 3] [1 #{:b :c :d} 4 3] [[nil #{:a} 3] [nil #{:d} 4 3] [1 #{:b :c}]]

        '()                '()                  [nil nil []]
        '(1 2 3)           '(2 3 4)             [[1 2 3] [2 3 4] nil]
        '(1 2 3)           '(1 2 4)             [[nil nil 3] [nil nil 4] [1 2]]
        '(1 2 3)           '(1 2 3)             [nil nil [1 2 3]]
        '(1 2 3)           '(1 2 3 4)           [nil [nil nil nil 4] [1 2 3]]
        '(1 2 3)           '(5 9 3 2 3 7)       [[1 2] [5 9 nil 2 3 7] [nil nil 3]]
        '({:a 1 :b 2} 2 3) '({:a 1 :b 3} 0 3)   [[{:b 2} 2] [{:b 3} 0] [{:a 1} nil 3]]
        '(1 #{:a :b :c} 3) '(1 #{:b :c :d} 4 3) [[nil #{:a} 3] [nil #{:d} 4 3] [1 #{:b :c}]])))

  (testing "map types"
    (testing "map types never equal to non-map type"
      (are [x] (= [{} x nil] (diff {} x))
        ""
        "string"
        -1
        0
        1
        -1.0
        0.0
        1.0
        true
        false
        nil

        :kw
        :ns/kw
        'sym
        'ns/sym

        #inst "2020-06-04T22:32:29.871744"
        (datetime/date 2020 6 4)
        (datetime/time 22 35 38)
        3.1415926535M
        22/7
        #uuid "632ac3d8-fcfd-4d36-a05b-a54277a345bc"

        []
        [:a :b :c]
        '()
        '(:a :b :c)
        #{}
        #{:a :b :c}))

    (are [x y z] (= z (diff x y))
      {}                       {}                           [nil nil {}]
      {:a 1}                   {:a 1}                       [nil nil {:a 1}]
      {:a 1}                   {:a 2}                       [{:a 1} {:a 2} nil]
      {:a 1}                   {:b 2}                       [{:a 1} {:b 2} nil]
      {:a #{1 2 3}}            {:a #{2 3 4}}                [{:a #{1}} {:a #{4}} {:a #{3 2}}]
      {:a 1 :b {:c #{1 2 3}}}  {:a 2 :b {:c #{2 3 4}}}      [{:a 1 :b {:c #{1}}} {:a 2 :b {:c #{4}}} {:b {:c #{2 3}}}]
      {:a [1 2 3]}             {:a [5 9 3 2 3 7]}           [{:a [1 2]} {:a [5 9 nil 2 3 7]} {:a [nil nil 3]}]
      {:a [1 2 3]}             {:a '(5 9 3 2 3 7)}          [{:a [1 2]} {:a [5 9 nil 2 3 7]} {:a [nil nil 3]}]
      {:a 1 :b {:c '(1 2 3)}}  {:a 2 :b {:c [5 9 3 2 3 7]}} [{:a 1 :b {:c [1 2]}} {:a 2 :b {:c [5 9 nil 2 3 7]}} {:b {:c [nil nil 3]}}]
      {:a 1 :b {:c 2 :d 3}}    {:a 1 :b {:c 2 :e 5}}        [{:b {:d 3}} {:b {:e 5}} {:a 1 :b {:c 2}}]
      {:a {:e :f :g :h} :b :c} {:a {:e :z :g :h} :c :d}     [{:a {:e :f} :b :c} {:a {:e :z} :c :d} {:a {:g :h}}])))

(defn next-diff-seed [seed]
  (mod (+ (* seed 1103515245) 12345) 2147483648))

(defn seeded-diff-scalar [seed]
  (case (mod seed 6)
    0 (mod seed 97)
    1 (keyword (str "k" (mod seed 17)))
    2 (str "s" (mod seed 23))
    3 (zero? (mod seed 2))
    4 nil
    5 (symbol (str "sym" (mod seed 19)))))

(defn seeded-diff-value [seed depth]
  (if (zero? depth)
    (seeded-diff-scalar seed)
    (let [s1 (next-diff-seed seed)
          s2 (next-diff-seed s1)
          s3 (next-diff-seed s2)]
      (case (mod seed 5)
        0 (seeded-diff-scalar s1)
        1 [(seeded-diff-value s1 (dec depth))
           (seeded-diff-value s2 (dec depth))]
        2 {:a (seeded-diff-value s1 (dec depth))
           :b (seeded-diff-value s2 (dec depth))}
        3 (set [(seeded-diff-scalar s1)
                (seeded-diff-scalar s2)
                (seeded-diff-scalar s3)])
        4 [{:x (seeded-diff-value s1 (dec depth))}
           (set [(seeded-diff-scalar s2)])]))))

(deftest diff-identity-and-shared-structure-hold-under-seeded-fuzzing
  (let [property (prop/for-all [seed (gen/choose 0 100000)
                                depth (gen/choose 0 5)]
                   (let [shared (seeded-diff-value seed depth)
                         left (seeded-diff-value (next-diff-seed seed) depth)
                         right (seeded-diff-value
                                (next-diff-seed (next-diff-seed seed))
                                depth)
                         a {:left left
                            :shared shared
                            :nested [shared left]}
                         b {:right right
                            :shared shared
                            :nested [shared right]}
                         [same-a same-b same-both] (diff a a)
                         [_only-a _only-b both] (diff a b)]
                     (and (nil? same-a)
                          (nil? same-b)
                          (= a same-both)
                          (= shared (:shared both))
                          (= shared (get-in both [:nested 0])))))
        result (tc/quick-check 160 property :seed 20260724 :max-size 60)]
    (is (:pass? result))
    (is (= 160 (:num-tests result)))))

(deftest diff-false-empty-metadata-and-record-boundaries-test
  (testing "false and empty collections remain visible shared values"
    (are [a b expected] (= expected (diff a b))
      {:a false :b 1} {:a false :b 2} '({:b 1} {:b 2} {:a false})
      [false 1]       [false 2]       [[nil 1] [nil 2] [false]]
      [1 false]       [2 false]       [[1] [2] [nil false]]
      {:a [] :b 1}    {:a [] :b 2}    '({:b 1} {:b 2} {:a []})
      {:a {} :b 1}    {:a {} :b 2}    '({:b 1} {:b 2} {:a {}})
      {:a #{} :b 1}   {:a #{} :b 2}   '({:b 1} {:b 2} {:a #{}})))

  (testing "metadata-insensitive equality keeps the left value like Clojure"
    (let [[a b both] (diff ^{:left true} [1 2]
                           ^{:right true} [1 2])]
      (is (nil? a))
      (is (nil? b))
      (is (= [1 2] both))
      (is (= {:left true} (meta both)))))

  (testing "record/map equality does not bypass Clojure data's map diff shape"
    (let [record->map (diff (->Pair 1 2) {:a 1 :b 2})
          map->record (diff {:a 1 :b 2} (->Pair 1 2))
          same-record (diff (->Pair 1 2) (->Pair 1 2))]
      (is (seq? record->map))
      (is (seq? map->record))
      (is (= '(nil nil {:a 1 :b 2}) record->map))
      (is (= '(nil nil {:a 1 :b 2}) map->record))
      (is (= [nil nil (->Pair 1 2)] same-record)))))
