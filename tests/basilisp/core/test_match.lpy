(ns tests.basilisp.core.test-match
  (:require
   [basilisp.core.match :refer [match match-let matchm matchv]]
   [basilisp.test :refer [deftest is testing]]))

(deftest scalar-and-vector-match-test
  (testing "single occurrence match clauses may omit the extra pattern vector"
    (is (= :one (match 1
                  1 :one
                  :else :other))))

  (testing "vector patterns support literals, wildcards, bindings, and rest"
    (is (= [:a 4]
           (match [1 2 4]
             [1 2 b] [:a b]
             [a 2 4] [:b a]
             :else :bad)))
    (is (= [3 4]
           (match [[1 2 3 4]]
             [[1 2 & tail]] tail
             :else :bad)))))

(deftest map-and-special-pattern-test
  (testing "map patterns require key presence before matching nil values"
    (is (= [:present nil]
           (match [{:a nil}]
             [{:a x}] [:present x]
             :else :bad)))
    (is (= :missing
           (match [{:a nil}]
             [{:b nil}] :bad
             :else :missing))))

  (testing "seq, application, and as-patterns follow core.match syntax"
    (is (= [:seq 4]
           (match ['(1 2 4)]
             [([1 2 b] :seq)] [:seq b]
             :else :bad)))
    (is (= [(list 2 3) 2]
           (match ['(1 2 3)]
             [([1 & r] :seq)] [r (first r)]
             :else :bad)))
    (is (= 3
           (match ['(1 2 3)]
             [([1 & [2 x]] :seq)] x
             :else :bad)))
    (is (= :app
           (match [[1 2 3]]
             [[1 (3 :<< inc) 3]] :app
             :else :bad)))
    (is (= [1 2 [1 2]]
           (match [[1 2]]
             [([a b] :as whole)] [a b whole]
             :else :bad)))))

(deftest seq-pattern-scalar-fallback-test
  (testing "seq patterns fail instead of coercing non-seqable scalar values"
    (is (= [:fallback 41]
           (match [41]
             [([1 2] :seq)] :bad
             :else [:fallback 41])))
    (is (= [:fallback :keyword]
           (match [:keyword]
             [([:a :b] :seq)] :bad
             :else [:fallback :keyword])))))

(deftest compatibility-wrapper-macros-test
  (is (= 2
         (matchv :vector [[1 2]]
           [[1 x]] x
           :else :bad)))
  (is (= 2
         (matchm [{:a 1 :b 2}]
           [{:a 1 :b x}] x
           :else :bad)))
  (is (= :ok
         (match-let [x [1 2]]
           [[1 2]] :ok
           :else :bad))))

(deftest no-match-test
  (is (thrown? Exception
               (match [1]
                 [2] :bad))))
