(ns tests.basilisp.data-priority-map-test
  (:import random)
  (:require [basilisp.test :refer [deftest is]]
            [clojure.set :as set]
            [clojure.data.priority-map :as pm]))

(deftest priority-map-map-and-queue-contract
  (let [base (pm/priority-map :a 2 :b 1 :c 3)
        changed (assoc base :a 0)
        removed (dissoc changed :a)]
    (is (= 3 (count base)))
    (is (= 2 (:a base)))
    (is (= [[:b 1] [:a 2] [:c 3]] (vec base)))
    (is (= [:b :a :c] (vec (keys base))))
    (is (= [1 2 3] (vec (vals base))))
    (is (= [[:x 1] [:y 2] [:z 3]]
           (vec (into (pm/priority-map) [[:z 3] [:x 1] [:y 2]]))))
    (is (= [:b 1] (peek base)))
    (is (= [[:a 2] [:c 3]] (vec (pop base))))
    (is (= [[:c 3] [:a 2] [:b 1]] (vec (rseq base))))
    (is (= [[:a 0] [:b 1] [:c 3]] (vec changed)))
    (is (= [[:b 1] [:c 3]] (vec removed)))
    (is (= {:a 2 :b 1 :c 3} base))
    (is (= base (with-meta base {:origin :test})))
    (is (= {:origin :test} (meta (with-meta base {:origin :test}))))))

(deftest comparators-key-functions-and-priority-bounds
  (let [descending (pm/priority-map-by > :a 1 :b 3 :c 2)
        keyed      (pm/priority-map-keyfn first :a [2 :apple] :b [1 :banana] :c [2 :carrot])]
    (is (= [[:b 3] [:c 2] [:a 1]] (vec descending)))
    (is (= [[:b [1 :banana]] [:a [2 :apple]]]
           (vec (pm/priority-map-keyfn-by first < :a [2 :apple] :b [1 :banana]))))
    (is (= {:a [2 :apple] :b [1 :banana] :c [2 :carrot]} keyed))
    (is (= [1 2 2] (vec (map (comp first val) keyed))))
    (is (= [[:b 1] [:a 2]]
           (vec (pm/subseq (pm/priority-map :a 2 :b 1 :c 3) < 3))))
    (is (= [[:c 3] [:a 2]]
           (vec (pm/rsubseq (pm/priority-map :a 2 :b 1 :c 3) >= 2))))
    (is (= [[:d 4] [:c 3] [:a 2]]
           (vec (pm/rsubseq (pm/priority-map :a 2 :b 1 :c 3 :d 4 :e 5)
                            >= 2 < 5))))
    (is (= []
           (vec (pm/rsubseq (pm/priority-map :a 2 :b 1 :c 3 :d 4 :e 5)
                            <= 3 > 1))))
    (is (= [[:a 2]]
           (vec (pm/subseq (pm/priority-map :a 2 :b 1 :c 3) >= 2 < 3))))
    (is (= {1 #{:b} 2 #{:a :c}}
           (pm/priority->set-of-items (pm/priority-map :a 2 :b 1 :c 2))))))

(deftest public-constructor-and-apply-keyfn-contract
  (let [ascending (pm/->PersistentPriorityMap
                    (sorted-map 1 #{:b} 2 #{:c} 3 #{:a})
                    {:a [3 :apple] :b [1 :banana] :c [2 :carrot]}
                    {:origin :ctor}
                    first)
        descending (pm/->PersistentPriorityMap
                     (sorted-map-by > 1 #{:a} 3 #{:b} 2 #{:c})
                     {:a 1 :b 3 :c 2}
                     nil
                     nil)
        keyfn first]
    (is (contains? (ns-publics 'basilisp.data.priority-map) '->PersistentPriorityMap))
    (is (contains? (ns-publics 'basilisp.data.priority-map) 'apply-keyfn))
    (is (= [[:b [1 :banana]] [:c [2 :carrot]] [:a [3 :apple]]]
           (vec ascending)))
    (is (= [:b [1 :banana]] (peek ascending)))
    (is (= {:origin :ctor} (meta ascending)))
    (is (= [[:d [0 :date]] [:b [1 :banana]] [:c [2 :carrot]] [:a [3 :apple]]]
           (vec (assoc ascending :d [0 :date]))))
    (is (= [[:b 3] [:c 2] [:a 1]] (vec descending)))
    (is (= [:b 3] (peek descending)))
    (is (= 7 (pm/apply-keyfn [7 :seven])))
    (is (= [7 :seven] (let [keyfn nil]
                        (pm/apply-keyfn [7 :seven]))))))

(deftest priority-map-rejects-invalid-construction-and-empty-pop
  (is (thrown? Exception (pm/priority-map :a 1 :b)))
  (is (thrown? Exception (pop (pm/priority-map)))))

(deftest seeded-priority-queue-model-fuzz
  (let [rng (random/Random 95421)]
    (loop [step 0 model {} queue (pm/priority-map)]
      (if (= step 700)
        (is (= model queue))
        (let [item (keyword (str "k" (.randint rng 0 80)))]
          (if (< (.random rng) 0.67)
            (let [priority (.randint rng -20 20)
                  next-model (assoc model item priority)
                  next-queue (assoc queue item priority)]
              (is (= next-model next-queue))
              (when (seq next-model)
                (let [[expected-item expected-priority]
                      (first (sort-by val next-model))]
                  (is (= expected-priority (second (peek next-queue))))))
              (recur (inc step) next-model next-queue))
            (recur (inc step) (dissoc model item) (dissoc queue item))))))))

(deftest seeded-keyfn-by-priority-queue-model-fuzz
  (let [rng (random/Random 20260724)]
    (loop [step 0 model {} queue (pm/priority-map-keyfn-by first >)]
      (if (= step 650)
        (is (= model queue))
        (let [item (keyword (str "k" (.randint rng 0 95)))]
          (if (< (.random rng) 0.72)
            (let [priority (.randint rng -35 35)
                  payload [priority (keyword (str "payload-" step))]
                  next-model (assoc model item payload)
                  next-queue (assoc queue item payload)
                  expected-priorities (sort > (map first (vals next-model)))
                  observed-priorities (vec (map (comp first val) next-queue))]
              (is (= next-model next-queue))
              (is (= expected-priorities observed-priorities))
              (when (seq next-model)
                (is (= (first expected-priorities)
                       (first (val (peek next-queue)))))
                (is (= (set (keys next-model))
                       (apply set/union
                              (vals (pm/priority->set-of-items next-queue))))))
              (recur (inc step) next-model next-queue))
            (let [next-model (dissoc model item)
                  next-queue (dissoc queue item)
                  expected-priorities (sort > (map first (vals next-model)))]
              (is (= next-model next-queue))
              (is (= expected-priorities
                     (vec (map (comp first val) next-queue))))
              (recur (inc step) next-model next-queue))))))))
