(ns tests.basilisp.core-async-test
  (:import asyncio)
  (:require [basilisp.test :refer [deftest is testing]]
            [clojure.core.async :as async]))

(defasync core-async-rendezvous-roundtrip []
  (let [channel (async/chan)
        putter  (asyncio/create-task (async/put! channel :value))]
    (let [value (await (async/take! channel))]
      [value (await putter)])))

(defasync core-async-fixed-buffer-roundtrip []
  (let [channel (async/chan (async/buffer 2))]
    (await (async/put! channel :first))
    (await (async/put! channel :second))
    [(await (async/take! channel))
     (await (async/take! channel))]))

(defasync core-async-sliding-buffer-roundtrip []
  (let [channel (async/chan (async/sliding-buffer 2))]
    (await (async/put! channel :first))
    (await (async/put! channel :second))
    (await (async/put! channel :third))
    [(await (async/take! channel))
     (await (async/take! channel))]))

(defasync core-async-dropping-buffer-roundtrip []
  (let [channel (async/chan (async/dropping-buffer 2))]
    (await (async/put! channel :first))
    (await (async/put! channel :second))
    (await (async/put! channel :third))
    [(await (async/take! channel))
     (await (async/take! channel))]))

(defasync core-async-channel-transducer-roundtrip []
  (let [fanned      (async/chan 8 (mapcat (fn [value] [value (* value 10)])))
        filtered    (async/chan 4 (filter even?))
        partitioned (async/chan 4 (partition-all 2))]
    (await (async/put! fanned 1))
    (await (async/put! fanned 2))
    (async/close! fanned)
    (await (async/put! filtered 1))
    (await (async/put! filtered 2))
    (await (async/put! filtered 3))
    (await (async/put! filtered 4))
    (async/close! filtered)
    (await (async/put! partitioned 1))
    (await (async/put! partitioned 2))
    (await (async/put! partitioned 3))
    (async/close! partitioned)
    [[(await (async/take! fanned))
      (await (async/take! fanned))
      (await (async/take! fanned))
      (await (async/take! fanned))
      (await (async/take! fanned))]
     [(await (async/take! filtered))
      (await (async/take! filtered))
      (await (async/take! filtered))]
     [(await (async/take! partitioned))
      (await (async/take! partitioned))
      (await (async/take! partitioned))]]))

(defasync core-async-channel-transducer-completion-roundtrip []
  (let [limited (async/chan 4 (take 2))
        handled (async/chan 4
                            (map (fn [value]
                                   (if (even? value)
                                     (throw (python/RuntimeError "bad"))
                                     value)))
                            (fn [_error] :handled))
        dropped (async/chan 4
                            (map (fn [value]
                                   (if (even? value)
                                     (throw (python/RuntimeError "bad"))
                                     value)))
                            (fn [_error] nil))]
    (let [puts [(await (async/put! limited :first))
                (await (async/put! limited :second))
                (await (async/put! limited :third))]]
      (await (async/put! handled 1))
      (await (async/put! dropped 1))
      (await (async/put! handled 2))
      (await (async/put! dropped 2))
      (await (async/put! handled 3))
      (await (async/put! dropped 3))
      (async/close! handled)
      (async/close! dropped)
      [puts
       [(await (async/take! limited))
        (await (async/take! limited))
        (await (async/take! limited))]
       [(await (async/take! handled))
        (await (async/take! handled))
        (await (async/take! handled))
        (await (async/take! handled))]
       [(await (async/take! dropped))
        (await (async/take! dropped))
        (await (async/take! dropped))]])))

(defasync core-async-channel-transducer-nil-rejected? []
  (let [channel (async/chan 1 (map (fn [_] nil)))]
    (try
      (await (async/put! channel :input))
      false
      (catch Exception _
        true))))

(defasync core-async-callback-roundtrip []
  (let [channel (async/chan)
        events  (atom [])]
    (is (nil? (async/take! channel #(swap! events conj [:take %]))))
    (is (nil? (async/put! channel :callback #(swap! events conj [:put %]))))
    (await (asyncio/sleep 0))
    (await (asyncio/sleep 0))
    (await (asyncio/sleep 0))
    @events))

(defasync core-async-alts-roundtrip []
  (let [first  (async/chan 1)
        second (async/chan 1)]
    (await (async/put! first :first))
    (await (async/put! second :second))
    (let [[value selected] (await (async/alts! [second first] :priority true))
          [fallback port]  (await (async/alts! [(async/chan)] :default :fallback))]
      [value (identical? selected second) fallback port])))

(defasync core-async-timeout-roundtrip []
  (let [timer (async/timeout 1)]
    (await (async/take! timer))))

(defasync drain-channel! [channel]
  (loop [acc   []
         value (await (async/take! channel))]
    (if (some? value)
      (recur (conj acc value) (await (async/take! channel)))
      acc)))

(defasync put-values! [channel values]
  (loop [items (seq values)]
    (when items
      (await (async/put! channel (first items)))
      (recur (next items)))))

(defasync core-async-pipe-roundtrip []
  (let [source      (async/chan 2)
        destination (async/chan 2)]
    (await (async/put! source :first))
    (await (async/put! source :second))
    (async/close! source)
    (let [runner (async/pipe source destination)]
      (await runner)
      [(await (async/take! destination))
       (await (async/take! destination))
       (await (async/take! destination))])))

(defasync core-async-pipeline-roundtrip []
  (let [source      (async/chan 3)
        destination (async/chan 3)]
    (await (async/put! source 1))
    (await (async/put! source 2))
    (await (async/put! source 3))
    (async/close! source)
    (let [runner (async/pipeline 2 destination (map inc) source)]
      (await runner)
      [(await (async/take! destination))
       (await (async/take! destination))
       (await (async/take! destination))
       (await (async/take! destination))])))

(defasync core-async-pipeline-blocking-roundtrip []
  (let [source      (async/chan 3)
        destination (async/chan 3)]
    (await (async/put! source 1))
    (await (async/put! source 2))
    (await (async/put! source 3))
    (async/close! source)
    (let [runner (async/pipeline-blocking 2 destination (map inc) source)]
      (await runner)
      [(await (async/take! destination))
       (await (async/take! destination))
       (await (async/take! destination))
       (await (async/take! destination))])))

(defasync emit-async-pipeline-value [value out]
  (await (asyncio/sleep (/ (- 4 value) 100)))
  (await (async/put! out value))
  (await (async/put! out (* value 10)))
  (async/close! out))

(defn async-pipeline-fn [value out]
  (asyncio/create-task (emit-async-pipeline-value value out)))

(defasync core-async-pipeline-async-roundtrip []
  (let [source      (async/chan 3)
        destination (async/chan 8)]
    (await (async/put! source 1))
    (await (async/put! source 2))
    (await (async/put! source 3))
    (async/close! source)
    (let [runner (async/pipeline-async 2 destination async-pipeline-fn source)]
      (await runner)
      [(await (async/take! destination))
       (await (async/take! destination))
       (await (async/take! destination))
       (await (async/take! destination))
       (await (async/take! destination))
       (await (async/take! destination))
       (await (async/take! destination))])))

(defasync core-async-pipeline-async-close-false-roundtrip []
  (let [source      (async/chan 1)
        destination (async/chan 2)]
    (await (async/put! source 1))
    (async/close! source)
    (let [runner (async/pipeline-async 1 destination async-pipeline-fn source false)]
      (await runner)
      [(await (async/take! destination))
       (await (async/take! destination))
       (async/poll! destination)
       (await (async/put! destination :manual))])))

(defasync core-async-to-chan-roundtrip []
  (let [channel (async/to-chan! [1 2 3])]
    [(await (async/take! channel))
     (await (async/take! channel))
     (await (async/take! channel))
     (await (async/take! channel))]))

(defasync core-async-onto-chan-roundtrip []
  (let [channel    (async/chan 2)
        completion (async/onto-chan! channel [:first :second])]
    (await (async/take! completion))
    [(await (async/take! channel))
     (await (async/take! channel))
     (await (async/take! channel))]))

(defasync core-async-merge-roundtrip []
  (let [first  (async/to-chan! [1 2])
        second (async/to-chan! [3])
        output (async/merge [first second] 3)]
    (sort [(await (async/take! output))
           (await (async/take! output))
           (await (async/take! output))])))

(defasync core-async-split-roundtrip []
  (let [[even odd] (async/split even? (async/to-chan! [1 2 3 4]) 2 2)]
    [(await (async/take! even))
     (await (async/take! even))
     (await (async/take! even))
     (await (async/take! odd))
     (await (async/take! odd))
     (await (async/take! odd))]))

(defasync core-async-take-roundtrip []
  (let [output (async/take 2 (async/to-chan! [1 2 3]) 2)]
    [(await (async/take! output))
     (await (async/take! output))
     (await (async/take! output))]))

(defasync core-async-fold-roundtrip []
  [(await (async/take! (async/into [] (async/to-chan! [1 2 3]))))
   (await (async/take! (async/reduce + 0 (async/to-chan! [1 2 3]))))
   (await (async/take! (async/transduce (map inc) + 0 (async/to-chan! [1 2 3]))))])

(defasync core-async-transform-combinators-roundtrip []
  (let [map-in     (async/to-chan! [1 2])
        map-out    (async/map< #(* 10 %) map-in)
        filter-in  (async/to-chan! [1 2 3 4])
        filter-out (async/filter< even? filter-in 4)
        remove-in  (async/to-chan! [1 2 3 4])
        remove-out (async/remove< even? remove-in 4)
        cat-in     (async/to-chan! [1 2])
        cat-out    (async/mapcat< (fn [value] [value (* value 10)]) cat-in 4)
        target-map (async/chan 4)
        input-map  (async/map> #(* 10 %) target-map)
        target-fil (async/chan 4)
        input-fil  (async/filter> even? target-fil)
        target-rem (async/chan 4)
        input-rem  (async/remove> even? target-rem)
        target-cat (async/chan 4)
        input-cat  (async/mapcat> (fn [value] [value (* value 10)])
                                  target-cat
                                  4)]
    (await (put-values! input-map [1 2]))
    (async/close! input-map)
    (await (put-values! input-fil [1 2 3 4]))
    (async/close! input-fil)
    (await (put-values! input-rem [1 2 3 4]))
    (async/close! input-rem)
    (await (put-values! input-cat [1 2]))
    (async/close! input-cat)
    [(await (drain-channel! map-out))
     (await (drain-channel! filter-out))
     (await (drain-channel! remove-out))
     (await (drain-channel! cat-out))
     (await (drain-channel! target-map))
     (await (drain-channel! target-fil))
     (await (drain-channel! target-rem))
     (await (drain-channel! target-cat))]))

(defasync core-async-transform-combinators-stress-roundtrip []
  (let [values         (range 64)
        mapcat-source  (async/to-chan! values)
        mapcat-output  (async/mapcat< (fn [value]
                                        (if (zero? (mod value 5))
                                          []
                                          [value (- value)]))
                                      mapcat-source
                                      32)
        filter-target  (async/chan 64)
        filter-input   (async/filter> #(not= 0 (mod % 7)) filter-target)
        mapcat-target  (async/chan 64)
        mapcat-input   (async/mapcat> (fn [value] [value (* value value)])
                                      mapcat-target
                                      32)]
    (await (put-values! filter-input values))
    (async/close! filter-input)
    (await (put-values! mapcat-input (range 32)))
    (async/close! mapcat-input)
    [(await (drain-channel! mapcat-output))
     (await (drain-channel! filter-target))
     (await (drain-channel! mapcat-target))]))

(defasync core-async-mult-roundtrip []
  (let [source (async/chan 2)
        m      (async/mult source)
        left   (async/chan 2)
        right  (async/chan 2)
        left-ret?  (identical? left (async/tap m left))
        right-ret? (identical? right (async/tap m right false))]
    (await (async/put! source :one))
    (let [both [(await (async/take! left))
                (await (async/take! right))]]
      (async/untap m right)
      (await (async/put! source :two))
      (let [left-only [(await (async/take! left))
                       (async/poll! right)]]
        (await (asyncio/sleep 0))
        (async/close! source)
        (await (:task m))
        (let [closed (do
                       (await (async/take! left))
                       (async/poll! right))]
          [left-ret? right-ret? both left-only closed])))))

(defasync core-async-mult-unbuffered-parallel-roundtrip []
  (let [source (async/chan 1)
        m      (async/mult source)
        left   (async/chan)
        right  (async/chan)]
    (async/tap m left)
    (async/tap m right)
    (await (async/put! source :value))
    (let [right-take (asyncio/create-task (async/take! right))]
      (await (asyncio/sleep 0))
      (let [right-value (await (asyncio/wait_for right-take 1))
            left-value  (await (async/take! left))]
        (async/close! source)
        (await (:task m))
        [right-value left-value]))))

(defasync core-async-pub-roundtrip []
  (let [source      (async/chan 4)
        publication (async/pub source :topic)
        alpha       (async/chan 4)
        beta        (async/chan 4)
        alpha-ret?  (identical? alpha (async/sub publication :a alpha))
        beta-ret?   (identical? beta (async/sub publication :b beta false))]
    (await (async/put! source {:topic :a :value 1}))
    (await (async/put! source {:topic :b :value 2}))
    (await (async/put! source {:topic :c :value 3}))
    (let [matched [(await (async/take! alpha))
                   (await (async/take! beta))]]
      (async/unsub publication :b beta)
      (await (async/put! source {:topic :b :value 4}))
      (let [unsubbed (async/poll! beta)]
        (await (asyncio/sleep 0))
        (async/close! source)
        (await (:task publication))
        (let [closed (do
                       (await (async/take! alpha))
                       (async/poll! beta))]
          [alpha-ret? beta-ret? matched unsubbed closed])))))

(defasync core-async-mix-roundtrip []
  (let [out (async/chan 10)
        x   (async/chan 10)
        y   (async/chan 10)
        mx  (async/mix out)]
    (async/admix mx x)
    (async/admix mx y)
    (await (async/put! x :x1))
    (let [basic (await (async/take! out))]
      (async/toggle mx {x {:mute true}})
      (await (async/put! x :x-muted))
      (await (async/put! y :y-after-mute))
      (let [mute [(await (async/take! out))
                  (do
                    (await (asyncio/sleep 0))
                    (async/poll! out))]]
        (async/toggle mx {x {:mute false :pause true}})
        (await (async/put! x :x-paused))
        (await (async/put! y :y-after-pause))
        (let [pause-before [(await (async/take! out))
                            (do
                              (await (asyncio/sleep 0))
                              (async/poll! out))]]
          (async/toggle mx {x {:pause false}})
          (let [pause-after (await (async/take! out))]
            [basic mute pause-before pause-after]))))))

(defasync core-async-mix-solo-roundtrip []
  (let [default-out (async/chan 10)
        default-x   (async/chan 10)
        default-y   (async/chan 10)
        default-mx  (async/mix default-out)]
    (async/admix default-mx default-x)
    (async/admix default-mx default-y)
    (async/toggle default-mx {default-x {:solo true}})
    (await (asyncio/sleep 0))
    (await (async/put! default-y :y-default-solo))
    (await (async/put! default-x :x-default-solo))
    (let [default-solo [(await (async/take! default-out))
                        (do
                          (await (asyncio/sleep 0))
                          (async/poll! default-out))]]
      (async/toggle default-mx {default-x {:solo false}})
      (let [default-after (do
                            (await (asyncio/sleep 0))
                            (async/poll! default-out))
            pause-out     (async/chan 10)
            pause-x       (async/chan 10)
            pause-y       (async/chan 10)
            pause-mx      (async/mix pause-out)]
        (async/admix pause-mx pause-x)
        (async/admix pause-mx pause-y)
        (async/solo-mode pause-mx :pause)
        (async/toggle pause-mx {pause-x {:solo true}})
        (await (asyncio/sleep 0))
        (await (async/put! pause-y :y-paused-solo))
        (await (async/put! pause-x :x-paused-solo))
        (let [pause-solo [(await (async/take! pause-out))
                          (do
                            (await (asyncio/sleep 0))
                            (async/poll! pause-out))]]
          (async/toggle pause-mx {pause-x {:solo false}})
          [default-solo
           default-after
           pause-solo
           (await (async/take! pause-out))])))))

(defasync core-async-mix-toggle-add-roundtrip []
  (let [out (async/chan 10)
        x   (async/chan 10)
        mx  (async/mix out)]
    (async/toggle mx {x {:pause true}})
    (await (async/put! x :added-paused))
    (let [before (do
                   (await (asyncio/sleep 0))
                   (async/poll! out))]
      (async/toggle mx {x {:pause false}})
      [before (await (async/take! out))])))

(defn core-async-blocking-roundtrip []
  (let [channel (async/chan 1)
        first   (async/chan 1)
        second  (async/chan 1)]
    [(async/>!! channel :value)
     (async/<!! channel)
     (do
       (async/>!! first :first)
       (async/>!! second :second)
       (let [[value selected] (async/alts!! [second first] :priority true)
             [fallback port]  (async/alts!! [(async/chan)] :default :fallback)]
         [value (identical? selected second) fallback port]))]))

(defn core-async-thread-roundtrip []
  (let [from-call (async/thread-call (fn [] :thread-call-result))
        from-body (async/thread :thread-result)
        from-nil  (async/thread nil)]
    [(async/<!! from-call)
     (async/<!! from-call)
     (async/<!! from-body)
     (async/<!! from-body)
     (async/<!! from-nil)]))

(defn core-async-io-thread-roundtrip []
  (let [from-body (async/io-thread :io-thread-result)
        from-nil  (async/io-thread nil)]
    [(async/<!! from-body)
     (async/<!! from-body)
     (async/<!! from-nil)]))

(defn core-async-io-thread-stress-roundtrip []
  (let [channels (doall (map (fn [n] (async/io-thread n)) (range 32)))]
    (doall (map async/<!! channels))))

(defasync core-async-same-loop-blocking-rejected []
  (let [channel (async/chan 1)]
    (await (async/put! channel :value))
    [(try
       (async/<!! channel)
       false
       (catch Exception _
         true))
     (try
       (async/>!! channel :another)
       false
       (catch Exception _
         true))
     (try
       (async/alts!! [channel])
       false
       (catch Exception _
         true))]))

(deftest namespace-alias-test
  (is (= (find-ns 'basilisp.core.async) (find-ns 'clojure.core.async))))

(deftest public-surface-test
  (let [supported #{"buffer" "dropping-buffer" "sliding-buffer"
                    "chan" "close!" "offer!" "poll!" "put!" "take!"
                    "alts!" "timeout" "pipe" "pipeline"
                    "to-chan!" "onto-chan!" "merge" "split" "take"
                    "into" "reduce" "transduce"
                    "map<" "map>" "filter<" "filter>"
                    "remove<" "remove>" "mapcat<" "mapcat>"
                    "mult" "tap" "untap" "untap-all"
                    "pub" "sub" "unsub" "unsub-all"
                    "mix" "admix" "unmix" "unmix-all"
                    "toggle" "solo-mode"
                    "<!!" ">!!" "alts!!"
                    "thread" "thread-call" "io-thread"
                    "pipeline-async" "pipeline-blocking"}
        publics   (set (map name (keys (ns-publics 'clojure.core.async))))]
    (is (= supported publics))
    (is (not-any? publics ["go" "go-loop" "<!" ">!" "alt!"]))))

(deftest buffer-validation-test
  (is (thrown? Exception (async/buffer 0)))
  (is (thrown? Exception (async/dropping-buffer -1)))
  (is (thrown? Exception (async/sliding-buffer "2")))
  (is (thrown? Exception (async/chan {:capacity 1 :policy :fixed}))))

(deftest core-async-facade-test
  (testing "channels and buffers"
    (is (= [:value true] (asyncio/run (core-async-rendezvous-roundtrip))))
    (is (= [:first :second] (asyncio/run (core-async-fixed-buffer-roundtrip))))
    (is (= [:second :third] (asyncio/run (core-async-sliding-buffer-roundtrip))))
    (is (= [:first :second] (asyncio/run (core-async-dropping-buffer-roundtrip)))))
  (testing "channel transducers"
    (is (= [[1 10 2 20 nil] [2 4 nil] [[1 2] [3] nil]]
           (asyncio/run (core-async-channel-transducer-roundtrip))))
    (is (= [[true true false]
            [:first :second nil]
            [1 :handled 3 nil]
            [1 3 nil]]
           (asyncio/run (core-async-channel-transducer-completion-roundtrip))))
    (is (true? (asyncio/run (core-async-channel-transducer-nil-rejected?)))))
  (testing "callback-shaped put! and take!"
    (is (= #{[:take :callback] [:put true]}
           (set (asyncio/run (core-async-callback-roundtrip))))))
  (testing "selection, timeout, pipe, and pipeline"
    (is (= [:second true :fallback :default]
           (asyncio/run (core-async-alts-roundtrip))))
    (is (nil? (asyncio/run (core-async-timeout-roundtrip))))
    (is (= [:first :second nil]
           (asyncio/run (core-async-pipe-roundtrip))))
    (is (= [2 3 4 nil]
           (asyncio/run (core-async-pipeline-roundtrip)))))
  (testing "async and blocking pipeline variants"
    (is (= [2 3 4 nil]
           (asyncio/run (core-async-pipeline-blocking-roundtrip))))
    (is (= [1 10 2 20 3 30 nil]
           (asyncio/run (core-async-pipeline-async-roundtrip))))
    (is (= [1 10 nil true]
           (asyncio/run (core-async-pipeline-async-close-false-roundtrip)))))
  (testing "collection and channel combinators"
    (is (= [1 2 3 nil]
           (asyncio/run (core-async-to-chan-roundtrip))))
    (is (= [:first :second nil]
           (asyncio/run (core-async-onto-chan-roundtrip))))
    (is (= [1 2 3]
           (asyncio/run (core-async-merge-roundtrip))))
    (is (= [2 4 nil 1 3 nil]
           (asyncio/run (core-async-split-roundtrip))))
    (is (= [1 2 nil]
           (asyncio/run (core-async-take-roundtrip))))
    (is (= [[1 2 3] 6 9]
           (asyncio/run (core-async-fold-roundtrip))))
    (is (= [[10 20]
            [2 4]
            [1 3]
            [1 10 2 20]
            [10 20]
            [2 4]
            [1 3]
            [1 10 2 20]]
           (asyncio/run (core-async-transform-combinators-roundtrip))))
    (is (= [(vec (mapcat (fn [value]
                           (if (zero? (mod value 5))
                             []
                             [value (- value)]))
                         (range 64)))
            (vec (filter #(not= 0 (mod % 7)) (range 64)))
            (vec (mapcat (fn [value] [value (* value value)]) (range 32)))]
           (asyncio/run (core-async-transform-combinators-stress-roundtrip))))))

(deftest core-async-routing-combinators-test
  (testing "routing combinators"
    (let [actual (asyncio/run (core-async-mult-roundtrip))]
      (is (= [true true [:one :one] [:two nil] nil]
             actual)))
    (is (= [:value :value]
           (asyncio/run (core-async-mult-unbuffered-parallel-roundtrip))))
    (is (= [true true [{:topic :a :value 1} {:topic :b :value 2}] nil nil]
           (asyncio/run (core-async-pub-roundtrip))))
    (is (= [:x1 [:y-after-mute nil] [:y-after-pause nil] :x-paused]
           (asyncio/run (core-async-mix-roundtrip))))
    (is (= [[:x-default-solo nil] nil [:x-paused-solo nil] :y-paused-solo]
           (asyncio/run (core-async-mix-solo-roundtrip))))
    (is (= [nil :added-paused]
           (asyncio/run (core-async-mix-toggle-add-roundtrip))))))

(deftest core-async-blocking-bridges-test
  (testing "blocking operations and thread helpers"
    (is (= [true :value [:second true :fallback :default]]
           (core-async-blocking-roundtrip)))
    (is (= [:thread-call-result nil :thread-result nil nil]
           (core-async-thread-roundtrip)))
    (is (= [:io-thread-result nil nil]
           (core-async-io-thread-roundtrip)))
    (is (= (range 32)
           (core-async-io-thread-stress-roundtrip))))
  (testing "same-loop blocking is rejected"
    (is (= [true true true]
           (asyncio/run (core-async-same-loop-blocking-rejected))))))
