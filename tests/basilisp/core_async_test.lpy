(deftest core-async-blocking-bridges-test
  (testing "impl namespace compatibility shims"
    (is (= {'clojure.core.async.impl.protocols true
            'clojure.core.async.impl.buffers true
            'clojure.core.async.impl.channels true
            'clojure.core.async.impl.dispatch true
            'clojure.core.async.impl.ioc-macros true}
           (core-async-impl-publics-roundtrip)))
    (is (= {:fixed [1 true :fixed-a :fixed-b]
            :dropping [1 false true :drop-a]
            :sliding [1 false true :slide-b]
            :promise [1 false true :promise-a :promise-a]
            :datafy [{:count 0 :type 'FixedBuffer :capacity 1}
                     {:count 0 :type 'DroppingBuffer :capacity 1}
                     {:count 0 :type 'SlidingBuffer :capacity 1}
                     {:count 1 :type 'PromiseBuffer :capacity 1}]}
           (core-async-impl-buffer-roundtrip)))
    (is (= {:callback? true
            :active? true
            :blockable? false
            :lock-id 0
            :commit? true
            :seen [:delivered]}
           (core-async-impl-handler-roundtrip)))
    (is (= {:closed-before? false
            :put true
            :take :value
            :closed-after? true
            :closed-take nil
            :box :boxed
            :abort nil
            :cleanup nil
            :appm :arg}
