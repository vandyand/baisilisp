    (is (= {:workloads [true true true true]
            :rejects [true true]
            :called [:exec :run]
            :dispatch? false
            :blocking-check true
            :virtual-var? true}
           (core-async-impl-dispatch-roundtrip)))
    (is (= {:constants [0 1 2 3 4 5]
            :array [:five [:zero nil :two nil nil :five nil :seven]]
            :run [:step-done [[0 :initial]] :next 1]
            :return [true :returned nil]
            :terminators {'clojure.core.async/<! 'clojure.core.async.impl.ioc-macros/take!
                          'clojure.core.async/>! 'clojure.core.async.impl.ioc-macros/put!
                          'clojure.core.async/alts! 'clojure.core.async/ioc-alts!
                          :Return 'clojure.core.async.impl.ioc-macros/return-chan}}
           (core-async-ioc-helper-roundtrip)))
    (is (= {:thrown? true
            :message "boom"
            :closed-take nil}
           (core-async-ioc-wrapped-error-roundtrip)))
    (is (= {:take [:recur :ready 7]
            :put [:recur :value true 9]}
           (core-async-ioc-ready-roundtrip)))
    (is (= {:take [nil [[:later 11]] :later 11]
            :put [nil [[true 13]] true 13]}
           (core-async-ioc-enqueued-roundtrip)))
    (is (= (vec
            (for [idx (range 24)]
              (let [ready? (zero? (mod idx 3))]
                [idx
                 ready?
                 (if ready?
                   [:recur [] [:take idx] (+ 100 idx)]
                   [nil [[[:take idx] (+ 100 idx)]] [:take idx] (+ 100 idx)])
                 (if ready?
                   [:recur [] true (+ 200 idx)]
                   [nil [[true (+ 200 idx)]] true (+ 200 idx)])])))
           (core-async-ioc-generated-stress-roundtrip))))
  (testing "blocking operations and thread helpers"
    (is (= [true :value [:second true :fallback :default]]
           (core-async-blocking-roundtrip)))
    (is (= [[:second true] :first [true true :written] :fallback]
