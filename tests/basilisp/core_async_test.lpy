  (testing "task-backed constructors work from synchronous Clojure-shaped code"
    (is (= [[nil nil]
            [1 2 nil]
            [nil :a :b nil]
            [1 2]
            [2 nil 1 3 nil]
            [1 2 nil]
            [[1 2 3] 6 9]
            [2 3 nil]
            [[11 22 nil]
             [[1 2] [3] nil]
             [[1 3] [2 4] [5]]
             [1 2 1 nil]]
            [[2 3 nil]
             [1 3 nil]
             [2 3 nil]
             [1 -1 2 -2 nil]]
            [[:value :value nil nil]
