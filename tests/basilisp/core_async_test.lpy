           (core-async-sync-constructor-roundtrip))))
  (testing "coroutine-backed go parking"
    (is (= [:result nil [2 3] [3] [:second true] [[true true] :written] :fallback]
           (core-async-go-parking-roundtrip)))
    (is (= (range 1 33)
           (core-async-go-parking-stress-roundtrip)))
    (is (= (range 1 33)
           (core-async-go-nested-parking-stress-roundtrip)))
    (is (= [[true false] [true true] [:first true :second true] [true] nil]
           (core-async-go-parking-edge-roundtrip)))
    (is (= 42
           (asyncio/run (core-async-go-current-loop-roundtrip))))
    (is (= ['(async/<! input)
            '(async/>! output value)
            '(async/alt! input :branch)]
           (core-async-go-quoted-parking-roundtrip)))
    (is (true? (asyncio/run (core-async-go-blocking-inside-go-rejected))))
    (is (= {:ready [:recur [:ready true] 7]
            :put [:recur [true true] :written 11]
            :default [:recur [:fallback :default] 13]
            :enqueued [nil [[[:later true] 17]] [:later true] 17]}
           (core-async-ioc-alts-roundtrip)))
    (is (= (vec
            (for [idx (range 24)]
              (let [block (+ 300 idx)]
                (case (mod idx 3)
                  0 [idx :ready :recur [[:ready idx] true] block]
                  1 [idx :default :recur [[:fallback idx] :default] block]
                  2 [idx :enqueued nil [[ [[:later idx] true] block]]
                     [[:later idx] true] block]))))
           (core-async-ioc-alts-generated-roundtrip)))))
