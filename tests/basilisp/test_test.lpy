(ns tests.basilisp.test-test
  (:require [basilisp.test :refer :all]))

(defn- before-after-fixture
  [events]
  (fn []
    (swap! events conj :before)
    (yield)
    (swap! events conj :after)))

(defn- index-fixture
  [events idx]
  (fn []
    (swap! events conj idx)
    (yield)
    (swap! events conj idx)))

(def ^:dynamic *state* nil)

(deftest with-fixtures-test
  (testing "setup and teardown"
    (let [events (atom [])]
      (with-fixtures [(before-after-fixture events)]
        (swap! events conj :during))
      (is (= [:before :during :after] @events))))

  (testing "teardown on exception"
    (let [events (atom [])]
      (try
        (with-fixtures [(before-after-fixture events)]
          (swap! events conj :during)
          (throw (ex-info "Boom!" {})))
        (catch Exception _ nil))
      (is (= [:before :during :after] @events))))

  (testing "teardown on fixture setup exception"
    (let [events (atom [])]
      (try
        (with-fixtures [(before-after-fixture events)
                        #(throw (ex-info "Boom!" {}))]
          (swap! events conj :during))
        (catch Exception _ nil))
      (is (= [:before :after] @events))))

  (testing "teardown on fixture teardown exception"
    (let [events (atom [])]
      (try
        (with-fixtures [(before-after-fixture events)
                        (fn []
                          (yield)
                          (throw (ex-info "Boom!" {})))]
          (swap! events conj :during))
        (catch Exception _ nil))
      (is (= [:before :during :after] @events))))

  (testing "applied in order"
    (let [events  (atom nil)]
      (with-fixtures [(index-fixture events 1)
                      (index-fixture events 2)
                      (index-fixture events 3)]
        (swap! events conj 4))
      (is (= '(1 2 3 4 3 2 1) @events))))

  (testing "nesting fixtures"
    (with-fixtures [(fn [run]
                      (with-fixtures [(fn [inner]
                                        (binding [*state* 1]
                                          (inner)))]
                        (run)))]
      (is (= 1 *state*))))

  (testing "Clojure-style thunk fixtures"
    (let [events (atom [])]
      (with-fixtures [(fn [f]
                        (swap! events conj :before)
                        (f)
                        (swap! events conj :after))]
        (swap! events conj :during))
      (is (= [:before :during :after] @events)))))

(deftest join-fixtures-test
  (testing "applied in order"
    (let [events  (atom nil)]
      (with-fixtures [(join-fixtures [(index-fixture events 1)
                                      (index-fixture events 2)
                                      (index-fixture events 3)])]
        (swap! events conj 4))
      (is (= '(1 2 3 4 3 2 1) @events)))))

(deftest clojure-style-fixture-composition-accepts-test-thunks
  (let [events (atom [])
        f1 (fn [run]
             (swap! events conj :f1-before)
             (run)
             (swap! events conj :f1-after))
        f2 (fn [run]
             (swap! events conj :f2-before)
             (run)
             (swap! events conj :f2-after))]
    ((join-fixtures [f1 f2]) #(swap! events conj :joined-body))
    ((compose-fixtures f1 f2) #(swap! events conj :composed-body))
    (is (= [:f1-before :f2-before :joined-body :f2-after :f1-after
            :f1-before :f2-before :composed-body :f2-after :f1-after]
           @events))))

(deftest portable-thrown-assertion-test
  ;; This matches clojure-test-suite's ``p/thrown?`` assertion form. ``p`` is
  ;; deliberately not a runtime alias: ``is`` must dispatch it while expanding.
  (is (p/thrown? (+ 1 nil))))

(deftest equality-assertions-return-clojure-boolean-results
  (let [observed (volatile! nil)
        counters (volatile! nil)]
    (binding [report (fn [m]
                       (case (:type m)
                         :pass (vswap! counters update :pass (fnil inc 0))
                         :fail (vswap! counters update :fail (fnil inc 0))
                         nil))]
      (vreset! counters *initial-report-counters*)
      (let [pairs [[0 0 true]
                   [0 1 false]
                   [:same :same true]
                   [:left :right false]
                   [[1 2] '(1 2) true]
                   [{:a 1 :b 2} {:b 2 :a 1} true]
                   [#{1 2 3} #{3 2 1} true]
                   [nil nil true]
                   [nil false false]
                   [true true true]
                   [true false false]]]
        (vreset! observed
                 (mapv (fn [[left right expected]]
                         [(is (= left right)) expected])
                       pairs))))
    (is (= [[true true]
            [false false]
            [true true]
            [false false]
            [true true]
            [true true]
            [true true]
            [true true]
            [false false]
            [true true]
            [false false]]
           @observed))
    (is (= {:test 0 :pass 7 :fail 4 :error 0}
           @counters))))

(deftest thrown-with-msg-returns-caught-exception-after-reporting
  (let [observed (volatile! nil)
        counters (volatile! nil)]
    (binding [report (fn [m]
                       (case (:type m)
                         :pass (vswap! counters update :pass (fnil inc 0))
                         :fail (vswap! counters update :fail (fnil inc 0))
                         :error (vswap! counters update :error (fnil inc 0))
                         nil))]
      (vreset! counters *initial-report-counters*)
      (vreset! observed
               [(some? (is (thrown? python/Exception
                                     (throw (python/Exception "boom")))))
                (nil? (is (thrown? python/Exception 42)))
                (some? (is (thrown-with-msg? python/Exception
                                              #"boom"
                                              (throw (python/Exception "boom")))))
                (some? (is (thrown-with-msg? python/Exception
                                              #"missing"
                                              (throw (python/Exception "boom")))))
                (nil? (is (thrown-with-msg? python/Exception
                                            #"anything"
                                            42)))
                (nil? (is (thrown-with-msg? python/ValueError
                                            #"boom"
                                            (throw (python/Exception "boom")))))]))
    (is (= [true true true true true true] @observed))
    (is (= {:test 0 :pass 2 :fail 4 :error 0}
           @counters))))
