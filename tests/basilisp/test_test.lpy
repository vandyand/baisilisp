(ns tests.basilisp.test-test
  (:require [basilisp.string :as str]
            [basilisp.test :refer :all]))

(defn- before-after-fixture
  [events]
  (fn []
    (swap! events conj :before)
    (yield)
    (swap! events conj :after)))

(defn- index-fixture
  [events idx]
  (fn []
    (swap! events conj idx)
    (yield)
    (swap! events conj idx)))

(def ^:dynamic *state* nil)

(deftest with-fixtures-test
  (testing "setup and teardown"
    (let [events (atom [])]
      (with-fixtures [(before-after-fixture events)]
        (swap! events conj :during))
      (is (= [:before :during :after] @events))))

  (testing "teardown on exception"
    (let [events (atom [])]
      (try
        (with-fixtures [(before-after-fixture events)]
          (swap! events conj :during)
          (throw (ex-info "Boom!" {})))
        (catch Exception _ nil))
      (is (= [:before :during :after] @events))))

  (testing "teardown on fixture setup exception"
    (let [events (atom [])]
      (try
        (with-fixtures [(before-after-fixture events)
                        #(throw (ex-info "Boom!" {}))]
          (swap! events conj :during))
        (catch Exception _ nil))
      (is (= [:before :after] @events))))

  (testing "teardown on fixture teardown exception"
    (let [events (atom [])]
      (try
        (with-fixtures [(before-after-fixture events)
                        (fn []
                          (yield)
                          (throw (ex-info "Boom!" {})))]
          (swap! events conj :during))
        (catch Exception _ nil))
      (is (= [:before :during :after] @events))))

  (testing "applied in order"
    (let [events  (atom nil)]
      (with-fixtures [(index-fixture events 1)
                      (index-fixture events 2)
                      (index-fixture events 3)]
        (swap! events conj 4))
      (is (= '(1 2 3 4 3 2 1) @events))))

  (testing "nesting fixtures"
    (with-fixtures [(fn [run]
                      (with-fixtures [(fn [inner]
                                        (binding [*state* 1]
                                          (inner)))]
                        (run)))]
      (is (= 1 *state*))))

  (testing "Clojure-style thunk fixtures"
    (let [events (atom [])]
      (with-fixtures [(fn [f]
                        (swap! events conj :before)
                        (f)
                        (swap! events conj :after))]
        (swap! events conj :during))
      (is (= [:before :during :after] @events)))))

(deftest join-fixtures-test
  (testing "applied in order"
    (let [events  (atom nil)]
      (with-fixtures [(join-fixtures [(index-fixture events 1)
                                      (index-fixture events 2)
                                      (index-fixture events 3)])]
        (swap! events conj 4))
      (is (= '(1 2 3 4 3 2 1) @events)))))

(deftest clojure-style-fixture-composition-accepts-test-thunks
  (let [events (atom [])
        f1 (fn [run]
             (swap! events conj :f1-before)
             (run)
             (swap! events conj :f1-after))
        f2 (fn [run]
             (swap! events conj :f2-before)
             (run)
             (swap! events conj :f2-after))]
    ((join-fixtures [f1 f2]) #(swap! events conj :joined-body))
    ((compose-fixtures f1 f2) #(swap! events conj :composed-body))
    (is (= [:f1-before :f2-before :joined-body :f2-after :f1-after
            :f1-before :f2-before :composed-body :f2-after :f1-after]
           @events))))

(deftest portable-thrown-assertion-test
  ;; This matches clojure-test-suite's ``p/thrown?`` assertion form. ``p`` is
  ;; deliberately not a runtime alias: ``is`` must dispatch it while expanding.
  (is (p/thrown? (+ 1 nil))))

(deftest equality-assertions-return-clojure-boolean-results
  (let [observed (volatile! nil)
        counters (volatile! nil)]
    (binding [report (fn [m]
                       (case (:type m)
                         :pass (vswap! counters update :pass (fnil inc 0))
                         :fail (vswap! counters update :fail (fnil inc 0))
                         nil))]
      (vreset! counters *initial-report-counters*)
      (let [pairs [[0 0 true]
                   [0 1 false]
                   [:same :same true]
                   [:left :right false]
                   [[1 2] '(1 2) true]
                   [{:a 1 :b 2} {:b 2 :a 1} true]
                   [#{1 2 3} #{3 2 1} true]
                   [nil nil true]
                   [nil false false]
                   [true true true]
                   [true false false]]]
        (vreset! observed
                 (mapv (fn [[left right expected]]
                         [(is (= left right)) expected])
                       pairs))))
    (is (= [[true true]
            [false false]
            [true true]
            [false false]
            [true true]
            [true true]
            [true true]
            [true true]
            [false false]
            [true true]
            [false false]]
           @observed))
    (is (= {:test 0 :pass 7 :fail 4 :error 0}
           @counters))))

(deftest equality-assertions-use-all-arities-and-clojure-report-shapes
  (let [observed (volatile! nil)
        events (volatile! [])]
    (binding [report (fn [m]
                       (vswap! events conj
                               (select-keys m [:type :message :expected :actual]))
                       nil)]
      (vreset! observed
               [(is (=) "zero")
                (is (= 1) "one")
                (is (= 1 1 1 1) "many-pass")
                (is (= 1 1 2 1) "many-fail")
                (is (= :a :a :a) "keywords")
                (is (= [:a 1] [:a 1] '(:a 2)) "sequential-fail")]))
    (is (= [nil true true false true false] @observed))
    (is (= [{:type :error
             :message "zero"
             :expected '(=)
             :actual-kind :exception}
            {:type :pass
             :message "one"
             :expected '(= 1)
             :actual '(= 1)}
            {:type :pass
             :message "many-pass"
             :expected '(= 1 1 1 1)
             :actual '(= 1 1 1 1)}
            {:type :fail
             :message "many-fail"
             :expected '(= 1 1 2 1)
             :actual '(not (= 1 1 2 1))}
            {:type :pass
             :message "keywords"
             :expected '(= :a :a :a)
             :actual '(= :a :a :a)}
            {:type :fail
             :message "sequential-fail"
             :expected '(= [:a 1] [:a 1] '(:a 2))
             :actual '(not (= [:a 1] [:a 1] (:a 2)))}]
           (mapv (fn [event]
                   (if (= :error (:type event))
                     (-> event
                         (dissoc :actual)
                         (assoc :actual-kind (if (some? (:actual event))
                                               :exception
                                               :missing)))
                     event))
                 @events)))))

(deftest thrown-with-msg-returns-caught-exception-after-reporting
  (let [observed (volatile! nil)
        counters (volatile! nil)]
    (binding [report (fn [m]
                       (case (:type m)
                         :pass (vswap! counters update :pass (fnil inc 0))
                         :fail (vswap! counters update :fail (fnil inc 0))
                         :error (vswap! counters update :error (fnil inc 0))
                         nil))]
      (vreset! counters *initial-report-counters*)
      (vreset! observed
               [(some? (is (thrown? python/Exception
                                     (throw (python/Exception "boom")))))
                (nil? (is (thrown? python/Exception 42)))
                (some? (is (thrown-with-msg? python/Exception
                                              #"boom"
                                              (throw (python/Exception "boom")))))
                (some? (is (thrown-with-msg? python/Exception
                                              #"missing"
                                              (throw (python/Exception "boom")))))
                (nil? (is (thrown-with-msg? python/Exception
                                            #"anything"
                                            42)))
                (nil? (is (thrown-with-msg? python/ValueError
                                            #"boom"
                                            (throw (python/Exception "boom")))))]))
    (is (= [true true true true true true] @observed))
    (is (= {:test 0 :pass 2 :fail 3 :error 1}
           @counters))))

(deftest exception-assertions-use-clojure-report-shapes
  (let [events (volatile! [])]
    (binding [report (fn [m]
                       (vswap! events conj
                               (let [actual (:actual m)]
                                 {:type (:type m)
                                  :message (:message m)
                                  :expected (pr-str (:expected m))
                                  :actual-kind (cond
                                                 (instance? python/BaseException actual) :exception
                                                 (nil? actual) :nil
                                                 :else :value)
                                  :actual (cond
                                            (instance? python/BaseException actual) (python/str actual)
                                            :else (pr-str actual))}))
                       nil)]
      (is (thrown? python/Exception
                   (throw (python/Exception "boom")))
          "thrown-pass")
      (is (thrown? python/Exception 42)
          "thrown-no")
      (is (thrown? python/ValueError
                   (throw (python/Exception "boom")))
          "thrown-wrong")
      (is (thrown-with-msg? python/Exception
                            #"boom"
                            (throw (python/Exception "boom")))
          "msg-pass")
      (is (thrown-with-msg? python/Exception
                            #"missing"
                            (throw (python/Exception "boom")))
          "msg-mismatch")
      (is (thrown-with-msg? python/Exception
                            #"anything"
                            42)
          "msg-no")
      (is (thrown-with-msg? python/ValueError
                            #"boom"
                            (throw (python/Exception "boom")))
          "msg-wrong"))
    (is (= [{:type :pass
             :message "thrown-pass"
             :expected "(thrown? python/Exception (throw (python/Exception \"boom\")))"
             :actual-kind :exception
             :actual "boom"}
            {:type :fail
             :message "thrown-no"
             :expected "(thrown? python/Exception 42)"
             :actual-kind :nil
             :actual "nil"}
            {:type :error
             :message "thrown-wrong"
             :expected "(thrown? python/ValueError (throw (python/Exception \"boom\")))"
             :actual-kind :exception
             :actual "boom"}
            {:type :pass
             :message "msg-pass"
             :expected "(thrown-with-msg? python/Exception #\"boom\" (throw (python/Exception \"boom\")))"
             :actual-kind :exception
             :actual "boom"}
            {:type :fail
             :message "msg-mismatch"
             :expected "(thrown-with-msg? python/Exception #\"missing\" (throw (python/Exception \"boom\")))"
             :actual-kind :exception
             :actual "boom"}
            {:type :fail
             :message "msg-no"
             :expected "(thrown-with-msg? python/Exception #\"anything\" 42)"
             :actual-kind :nil
             :actual "nil"}
            {:type :error
             :message "msg-wrong"
             :expected "(thrown-with-msg? python/ValueError #\"boom\" (throw (python/Exception \"boom\")))"
             :actual-kind :exception
             :actual "boom"}]
           @events))))

(deftest instance-and-predicate-assertions-use-clojure-report-shapes
  (let [observed (volatile! nil)
        events (volatile! [])]
    (binding [report (fn [m]
                       (vswap! events conj
                               (let [actual (:actual m)]
                                 {:type (:type m)
                                  :message (:message m)
                                  :expected (pr-str (:expected m))
                                  :actual (cond
                                            (= python/str actual) :str-class
                                            (= python/int actual) :int-class
                                            (nil? actual) :nil
                                            :else (pr-str actual))}))
                       nil)]
      (vreset! observed
               [(is (instance? python/str "x") "instance-pass")
                (is (instance? python/str 1) "instance-fail")
                (is (instance? python/str nil) "instance-nil")
                (is (string? 1) "predicate-fail")]))
    (is (= [true false false false] @observed))
    (is (= [{:type :pass
             :message "instance-pass"
             :expected "(instance? python/str \"x\")"
             :actual :str-class}
            {:type :fail
             :message "instance-fail"
             :expected "(instance? python/str 1)"
             :actual :int-class}
            {:type :fail
             :message "instance-nil"
             :expected "(instance? python/str nil)"
             :actual :nil}
            {:type :fail
             :message "predicate-fail"
             :expected "(string? 1)"
             :actual "(not (string? 1))"}]
           @events))))

(deftest qualified-core-assertion-heads-remain-generic-predicates
  (let [observed (volatile! nil)
        events (volatile! [])]
    (binding [report (fn [m]
                       (vswap! events conj
                               {:type (:type m)
                                :message (:message m)
                                :expected (pr-str (:expected m))
                                :actual (let [rendered (pr-str (:actual m))]
                                          (cond
                                            (str/includes? rendered "<class 'str'>")
                                            (str/replace rendered #"<class 'str'>" ":string-class")
                                            :else rendered))})
                       nil)]
      (vreset! observed
               [(is (basilisp.core/= 1 2) "fq-eq")
                (is (basilisp.core/instance? python/str "x") "fq-instance-pass")
                (is (basilisp.core/instance? python/str 1) "fq-instance-fail")
                (is (basilisp.core/not true) "fq-not")]))
    (is (= [false true false false] @observed))
    (is (= [{:type :fail
             :message "fq-eq"
             :expected "(basilisp.core/= 1 2)"
             :actual "(not (basilisp.core/= 1 2))"}
            {:type :pass
             :message "fq-instance-pass"
             :expected "(basilisp.core/instance? python/str \"x\")"
             :actual "(basilisp.core/instance? :string-class \"x\")"}
            {:type :fail
             :message "fq-instance-fail"
             :expected "(basilisp.core/instance? python/str 1)"
             :actual "(not (basilisp.core/instance? :string-class 1))"}
            {:type :fail
             :message "fq-not"
             :expected "(basilisp.core/not true)"
             :actual "(not (basilisp.core/not true))"}]
           @events))))
