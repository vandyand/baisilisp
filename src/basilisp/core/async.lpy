(ns basilisp.core.async
  "Compatibility facade for the portable subset of ``clojure.core.async``.

  This namespace intentionally wraps Basilisp's ``asyncio``-native
  ``basilisp.concurrent`` channel runtime. Parking macros and compiler-backed
  ``go`` blocks are not implemented here yet."
  (:refer-basilisp :exclude [into reduce take transduce])
  (:require [basilisp.concurrent :as concurrent])
  (:import asyncio))

(def ^:private buffer-key :basilisp.core.async/buffer)
(def Mux :basilisp.core.async/Mux)
(def Mult :basilisp.core.async/Mult)
(def Pub :basilisp.core.async/Pub)
(def Mix :basilisp.core.async/Mix)
(def ^:private fixed-policy :fixed)
(def ^:private dropping-policy :dropping)
(def ^:private sliding-policy :sliding)
(def ^:private no-prior-value (python/object))

(defn- positive-capacity
  [capacity buffer-kind]
  (when-not (pos-int? capacity)
    (throw (ex-info (str buffer-kind " requires a positive integer capacity")
                    {:capacity capacity
                     :buffer-kind buffer-kind})))
  capacity)

(defn- buffer-descriptor
  [policy capacity]
  {buffer-key true
   :policy    policy
   :capacity  (positive-capacity capacity policy)})

(defn- buffer-descriptor?
  [value]
  (and (map? value)
       (true? (get value buffer-key))
       (contains? value :policy)
       (contains? value :capacity)))

(defn buffer
  "Create a fixed buffer descriptor for ``chan``."
  [capacity]
  (buffer-descriptor fixed-policy capacity))

(defn dropping-buffer
  "Create a dropping buffer descriptor for ``chan``."
  [capacity]
  (buffer-descriptor dropping-policy capacity))

(defn sliding-buffer
  "Create a sliding buffer descriptor for ``chan``."
  [capacity]
  (buffer-descriptor sliding-policy capacity))

(defn- channel-capacity-policy
  [buf-or-n]
  (cond
    (nil? buf-or-n)
    [0 fixed-policy]

    (pos-int? buf-or-n)
    [buf-or-n fixed-policy]

    (buffer-descriptor? buf-or-n)
    [(:capacity buf-or-n) (:policy buf-or-n)]

    :else
    (throw (ex-info "chan expects nil, a positive integer capacity, or a buffer descriptor"
                    {:value buf-or-n}))))

(defn- make-channel
  [buf-or-n xform ex-handler]
  (let [[capacity policy] (channel-capacity-policy buf-or-n)]
    (if (nil? xform)
      (concurrent/chan capacity policy)
      (concurrent/chan capacity policy xform ex-handler))))

(defn chan
  "Create an ``asyncio``-native channel with Clojure-shaped buffer arguments.

  Supported forms:

  * ``(chan)``
  * ``(chan n)``
  * ``(chan (buffer n))``
  * ``(chan (dropping-buffer n))``
  * ``(chan (sliding-buffer n))``
  * ``(chan buf-or-n xform)``
  * ``(chan buf-or-n xform ex-handler)``"
  ([] (concurrent/chan))
  ([buf-or-n]
   (make-channel buf-or-n nil nil))
  ([buf-or-n xform]
   (make-channel buf-or-n xform nil))
  ([buf-or-n xform ex-handler]
   (make-channel buf-or-n xform ex-handler)))

(defn promise-chan
  "Create a channel which realizes the first accepted non-``nil`` value and
  returns that value to every take. Closing before realization makes takes
  return ``nil``."
  ([]
   (concurrent/promise-chan))
  ([xform]
   (concurrent/promise-chan xform))
  ([xform ex-handler]
   (concurrent/promise-chan xform ex-handler)))

(defn close!
  "Close ``channel``."
  [channel]
  (concurrent/close! channel))

(defn offer!
  "Try to put ``value`` on ``channel`` without waiting."
  [channel value]
  (concurrent/offer! channel value))

(defn poll!
  "Try to take a value from ``channel`` without waiting, returning ``nil`` when
  no value is immediately available or the closed channel is drained."
  [channel]
  (concurrent/poll! channel))

(defn- schedule-callback!
  [awaitable callback]
  (let [task (asyncio/create-task awaitable)]
    (.add_done_callback task (fn [completed]
                               (callback (.result completed))))
    nil))

(defn put!
  "Put ``value`` on ``channel``.

  Without a callback this returns an awaitable, matching
  ``basilisp.concurrent/put!``. With a callback it schedules the operation on
  the current event loop, calls the callback with ``true`` or ``false``, and
  returns ``nil``."
  ([channel value]
   (concurrent/put! channel value))
  ([channel value callback]
   (schedule-callback! (concurrent/put! channel value) callback)))

(defn take!
  "Take a value from ``channel``.

  Without a callback this returns an awaitable, matching
  ``basilisp.concurrent/take!``. With a callback it schedules the operation on
  the current event loop, calls the callback with the taken value or ``nil``,
  and returns ``nil``."
  ([channel]
   (concurrent/take! channel))
  ([channel callback]
   (schedule-callback! (concurrent/take! channel) callback)))

(defn >!!
  "Blocking put of ``value`` onto ``channel``.

  This is a synchronous bridge for Clojure source compatibility. It rejects
  calls that would block the owning running event loop."
  [channel value]
  (concurrent/blocking-put! channel value))

(defn <!!
  "Blocking take from ``channel``.

  Returns ``nil`` when the channel is closed and drained. Calls from the owning
  running event loop are rejected to avoid deadlock."
  [channel]
  (concurrent/blocking-take! channel))

(defn alts!!
  "Blocking counterpart to ``alts!``."
  [ports & opts]
  (apply concurrent/blocking-alts! ports opts))

(defn fn-handler
  "Return an opaque BaisiLisp handler descriptor for ``f``.

  Clojure exposes this lower-level helper for its channel implementation. The
  BaisiLisp facade keeps the public shape available for source compatibility;
  direct channel operations use Python-native callbacks instead of Clojure's
  handler protocol."
  ([f]
   (fn-handler f true))
  ([f blockable]
   {:basilisp.core.async/handler true
    :f f
    :blockable blockable}))

(defn- alts-task!
  [fret ports opts]
  (let [task (asyncio/create-task
              (apply concurrent/alts! ports (apply concat opts)))]
    (.add_done_callback task (fn [completed]
                               (fret (.result completed))))
    nil))

(defn do-alts
  "Return a derefable ``[value port]`` if a channel operation is immediately
  ready; otherwise enqueue the operation and return ``nil``.

  When enqueued, ``fret`` is called later with the selected ``[value port]``.
  This mirrors Clojure's public helper shape for the direct channel runtime;
  full ``go``/IOC integration remains a compiler tranche."
  [fret ports opts]
  (assert (pos? (count ports)) "alts must have at least one channel operation")
  (let [[ready? result] (concurrent/try-alts! ports opts)]
    (if ready?
      (delay result)
      (alts-task! fret ports opts))))

(defmacro defblockingop
  "Define a blocking operation with Clojure-shaped public metadata."
  [op doc arglist & body]
  (let [arglists-meta (list 'quote (list arglist))]
    `(def ~(with-meta op {:arglists arglists-meta :doc doc})
       (fn ~arglist
         ~@body))))

(defn- do-alt*
  [alts clauses await?]
  (assert (even? (count clauses)) "unbalanced clauses")
  (let [clause-pairs (basilisp.core/partition 2 clauses)
        option?      #(keyword? (first %))
        opts         (basilisp.core/filter option? clause-pairs)
        clauses      (basilisp.core/remove option? clause-pairs)
        [clauses bindings]
        (basilisp.core/reduce
         (fn [[clauses bindings] [ports expr]]
           (let [ports (if (vector? ports) ports [ports])
                 [ports bindings]
                 (basilisp.core/reduce
                  (fn [[ports bindings] port]
                    (if (vector? port)
                      (let [[port val] port
                            gp         (gensym)
                            gv         (gensym)]
                        [(conj ports [gp gv])
                         (conj bindings [gp port] [gv val])])
                      (let [gp (gensym)]
                        [(conj ports gp)
                         (conj bindings [gp port])])))
                  [[] bindings]
                  ports)]
             [(conj clauses [ports expr]) bindings]))
         [[] []]
         clauses)
        value-sym (gensym "value")
        port-sym  (gensym "port")
        ret-sym   (gensym "ret")
        alts-call `(~alts [~@(apply concat (basilisp.core/map first clauses))]
                      ~@(apply concat opts))]
    `(let [~@(basilisp.core/mapcat identity bindings)
           [~value-sym ~port-sym :as ~ret-sym] ~(if await?
                                                  `(await ~alts-call)
                                                  alts-call)]
       (cond
         ~@(basilisp.core/mapcat
            (fn [[ports expr]]
              [`(or ~@(basilisp.core/map
                       (fn [port]
                         `(= ~port-sym ~(if (vector? port)
                                          (first port)
                                          port)))
                       ports))
               (if (and (seq? expr) (vector? (first expr)))
                 `(let [~(first expr) ~ret-sym] ~@(rest expr))
                 expr)])
            clauses)
         (= ~port-sym :default) ~value-sym))))

(defn do-alt
  "Return the macro expansion shared by ``alt!!`` and parking ``alt!``.
  ``alts`` is the selection function symbol and ``clauses`` is the alternating
  channel-operation/result-expression form sequence."
  [alts clauses]
  (do-alt* alts clauses false))

(defmacro alt!!
  "Blocking choice macro over channel operations.

  Each clause is ``channel-op[s] result-expr``. Channel ops match Clojure
  ``core.async/alt!!``: a take channel, a vector of take channels and/or
  ``[put-channel value]`` operations, plus ``:default`` and ``:priority``
  options. A result expression beginning with a vector binds the ``[value
  port]`` result from ``alts!!``."
  [& clauses]
  (do-alt `alts!! clauses))

(defasync ^:private run-go-body!
  [result-channel body-fn]
  (try
    (let [result (await (body-fn))]
      (when (some? result)
        (await (put! result-channel result))))
    (finally
      (close! result-channel))))

(defmacro go
  "Run ``body`` in a caller-owned ``asyncio`` task and return a channel which
  receives the non-``nil`` body result before close.

  This is a coroutine-backed source-compatibility subset of Clojure
  ``core.async/go``. Parking operations ``<!``, ``>!``, and ``alt!`` lower to
  ``await`` over the existing channel runtime."
  [& body]
  (let [body-fn (with-meta (concat '(fn []) body) {:async true})]
    `(let [result-channel# (chan 1)]
       (concurrent/submit-task!
        (@#'basilisp.core.async/run-go-body! result-channel# ~body-fn))
       result-channel#)))

(defmacro go-loop
  "Coroutine-backed ``go`` plus ``loop``."
  [bindings & body]
  `(go (loop ~bindings ~@body)))

(defmacro <!
  "Take from ``port`` inside the coroutine-backed parking subset."
  [port]
  `(await (take! ~port)))

(defmacro >!
  "Put ``value`` on ``port`` inside the coroutine-backed parking subset."
  [port value]
  `(await (put! ~port ~value)))

(defmacro alt!
  "Parking choice macro over channel operations in the coroutine-backed
  ``go`` subset."
  [& clauses]
  (do-alt* `alts! clauses true))

(defn ioc-alts!
  "Clojure exposes this helper for compiler-generated IOC state machines.

  BaisiLisp's current ``go`` tranche is coroutine-backed, so there is no public
  IOC state-machine representation to resume here. The public name is present
  for source compatibility and rejects direct calls deterministically."
  [state cont-block ports & opts]
  (throw (ex-info "ioc-alts! requires Clojure-style IOC state-machine support"
                  {:state state
                   :cont-block cont-block
                   :ports ports
                   :opts opts})))

(defn thread-call
  "Run zero-argument ``f`` in another thread and return a channel receiving the
  result before close. The optional ``workload`` argument is accepted for
  Clojure-shaped compatibility and currently does not change executor
  selection."
  ([f]
   (concurrent/thread-call! f))
  ([f _workload]
   (thread-call f)))

(defmacro thread
  "Execute ``body`` in another thread, returning a channel which receives the
  result before close."
  [& body]
  `(thread-call (fn* [] ~@body)))

(defmacro io-thread
  "Execute ``body`` in another thread for blocking I/O work, returning a
  channel which receives the non-``nil`` result before close.

  BaisiLisp currently routes this through the same worker-thread executor as
  ``thread`` while preserving Clojure's public macro shape."
  [& body]
  `(thread-call (fn* [] ~@body) :io))

(defasync alts!
  "Await exactly one take channel or ``[channel value]`` put operation.

  This is an awaitable BaisiLisp extension until ``go`` parking support is
  implemented."
  [ports & opts]
  (await (apply concurrent/alts! ports opts)))

(defasync ^:private copy-coll-to-channel!
  [channel coll close? completion]
  (try
    (loop [items (seq coll)]
      (when items
        (when (await (put! channel (first items)))
          (recur (next items)))))
    (finally
      (when close?
        (close! channel))
      (when completion
        (close! completion)))))

(defn to-chan!
  "Create and return a channel containing the contents of ``coll``.

  The channel closes when ``coll`` is exhausted. Access to ``coll`` occurs in an
  ``asyncio`` task and should not block."
  [coll]
  (let [channel (chan)]
    (asyncio/create-task (copy-coll-to-channel! channel coll true nil))
    channel))

(defn to-chan
  "Alias for ``to-chan!`` retained for Clojure source compatibility."
  [coll]
  (to-chan! coll))

(defn to-chan!!
  "Blocking-shaped alias for ``to-chan!`` retained for Clojure source
  compatibility."
  [coll]
  (to-chan! coll))

(defn onto-chan!
  "Put the contents of ``coll`` into ``channel``.

  By default ``channel`` closes after the items are copied; pass ``false`` as
  ``close?`` to keep it open. Returns a completion channel which closes after
  copying finishes."
  ([channel coll]
   (onto-chan! channel coll true))
  ([channel coll close?]
   (let [completion (chan)]
     (asyncio/create-task (copy-coll-to-channel! channel coll close? completion))
     completion)))

(defn onto-chan
  "Alias for ``onto-chan!`` retained for Clojure source compatibility."
  ([channel coll]
   (onto-chan! channel coll))
  ([channel coll close?]
   (onto-chan! channel coll close?)))

(defn onto-chan!!
  "Blocking-shaped alias for ``onto-chan!`` retained for Clojure source
  compatibility."
  ([channel coll]
   (onto-chan! channel coll))
  ([channel coll close?]
   (onto-chan! channel coll close?)))

(defasync ^:private merge-one!
  [source output]
  (loop [value (await (take! source))]
    (when (some? value)
      (when (await (put! output value))
        (recur (await (take! source)))))))

(defasync ^:private merge-all!
  [sources output]
  (try
    (await (apply asyncio/gather
                  (map #(asyncio/create-task (merge-one! % output)) sources)))
    (finally
      (close! output))))

(defn merge
  "Return a channel containing all values taken from ``channels``.

  The returned channel closes after every source channel closes."
  ([channels]
   (merge channels nil))
  ([channels buf-or-n]
   (let [output (chan buf-or-n)]
     (asyncio/create-task (merge-all! channels output))
     output)))

(defasync ^:private split-all!
  [pred source true-output false-output]
  (try
    (loop [value (await (take! source))]
      (when (some? value)
        (let [target (if (pred value) true-output false-output)]
          (when (await (put! target value))
            (recur (await (take! source)))))))
    (finally
      (close! true-output)
      (close! false-output))))

(defn split
  "Split values from ``channel`` into ``[true-channel false-channel]`` by
  applying ``pred`` to each value."
  ([pred channel]
   (split pred channel nil nil))
  ([pred channel true-buf-or-n false-buf-or-n]
   (let [true-output  (chan true-buf-or-n)
         false-output (chan false-buf-or-n)]
     (asyncio/create-task (split-all! pred channel true-output false-output))
     [true-output false-output])))

(defasync ^:private take-values!
  [n source output]
  (try
    (loop [remaining n
           value     (when (pos? n) (await (take! source)))]
      (when (and (pos? remaining) (some? value))
        (when (await (put! output value))
          (let [next-remaining (dec remaining)]
            (recur next-remaining
                   (when (pos? next-remaining)
                     (await (take! source))))))))
    (finally
      (close! output))))

(defn take
  "Return a channel containing at most ``n`` values from ``channel``."
  ([n channel]
   (take n channel nil))
  ([n channel buf-or-n]
   (let [output (chan buf-or-n)]
     (asyncio/create-task (take-values! n channel output))
     output)))

(defasync ^:private into-result!
  [to channel output]
  (try
    (loop [result to
           value  (await (take! channel))]
      (if (some? value)
        (recur (conj result value) (await (take! channel)))
        (when (some? result)
          (await (put! output result)))))
    (finally
      (close! output))))

(defn into
  "Return a channel containing the collection result of conjoining all values
  from ``channel`` onto ``to``."
  [to channel]
  (let [output (chan 1)]
    (asyncio/create-task (into-result! to channel output))
    output))

(defasync ^:private reduce-result!
  [f init channel output]
  (try
    (loop [result init
           value  (await (take! channel))]
      (cond
        (reduced? result)
        (when (some? @result)
          (await (put! output @result)))

        (some? value)
        (recur (f result value) (await (take! channel)))

        :else
        (when (some? result)
          (await (put! output result)))))
    (finally
      (close! output))))

(defn reduce
  "Return a channel containing the result of reducing values from ``channel``."
  [f init channel]
  (let [output (chan 1)]
    (asyncio/create-task (reduce-result! f init channel output))
    output))

(defasync ^:private transduce-result!
  [xform f init channel output]
  (try
    (let [xf (xform f)]
      (loop [result init
             value  (await (take! channel))]
        (cond
          (reduced? result)
          (let [final (xf @result)]
            (when (some? final)
              (await (put! output final))))

          (some? value)
          (recur (xf result value) (await (take! channel)))

          :else
          (let [final (xf result)]
            (when (some? final)
              (await (put! output final)))))))
    (finally
      (close! output))))

(defn transduce
  "Return a channel containing the result of reducing values from ``channel``
  with the transformation ``xform`` applied to ``f``."
  [xform f init channel]
  (let [output (chan 1)]
    (asyncio/create-task (transduce-result! xform f init channel output))
    output))

(defn map<
  "Return a channel containing ``(f value)`` for each value taken from
  ``channel``. The returned channel closes after ``channel`` closes."
  [f channel]
  (let [output (chan)]
    (concurrent/pipeline! 1 channel output (map f))
    output))

(defn filter<
  "Return a channel containing values from ``channel`` for which ``pred``
  returns truthy."
  ([pred channel]
   (filter< pred channel nil))
  ([pred channel buf-or-n]
   (let [output (chan buf-or-n)]
     (concurrent/pipeline! 1 channel output (filter pred))
     output)))

(defn remove<
  "Return a channel containing values from ``channel`` for which ``pred``
  returns falsey."
  ([pred channel]
   (remove< pred channel nil))
  ([pred channel buf-or-n]
   (filter< (complement pred) channel buf-or-n)))

(defn mapcat<
  "Return a channel containing the concatenated results of applying ``f`` to
  each value taken from ``channel``."
  ([f channel]
   (mapcat< f channel nil))
  ([f channel buf-or-n]
   (let [output (chan buf-or-n)]
     (concurrent/pipeline! 1 channel output (mapcat f))
     output)))

(defn- transform-puts
  [xform target buf-or-n]
  (let [input (chan buf-or-n xform)]
    (concurrent/pipe! input target :close-output true)
    input))

(defn map>
  "Return a channel which applies ``f`` to each put value and forwards the
  result to ``channel``. Closing the returned channel closes ``channel``."
  [f channel]
  (transform-puts (map f) channel nil))

(defn filter>
  "Return a channel which forwards put values to ``channel`` only when ``pred``
  returns truthy. Filtered values are accepted and dropped."
  [pred channel]
  (transform-puts (filter pred) channel nil))

(defn remove>
  "Return a channel which forwards put values to ``channel`` only when ``pred``
  returns falsey. Filtered values are accepted and dropped."
  [pred channel]
  (filter> (complement pred) channel))

(defn mapcat>
  "Return a channel which applies ``f`` to each put value and forwards each
  value from the returned collection to ``channel``."
  ([f channel]
   (mapcat> f channel nil))
  ([f channel buf-or-n]
   (transform-puts (mapcat f) channel buf-or-n)))

(defn unblocking-buffer?
  "Return true for dropping and sliding buffer descriptors."
  [buf]
  (and (buffer-descriptor? buf)
       (contains? #{:dropping :sliding} (:policy buf))))

(defn- close-registered-channels!
  [registrations]
  (doseq [[channel close?] registrations]
    (when close?
      (close! channel))))

(defn- registration-put-tasks
  [registrations value]
  (loop [entries (seq registrations)
         tasks   []]
    (if (seq entries)
      (let [[channel _close?] (first entries)]
        (recur (next entries)
               (conj tasks [channel (asyncio/create-task
                                      (put! channel value))])))
      tasks)))

(defasync ^:private route-to-registrations!
  [registrations value remove!]
  (loop [tasks (seq (registration-put-tasks registrations value))]
    (when (seq tasks)
      (let [[channel task] (first tasks)
            accepted?     (await task)]
        (when-not accepted?
          (remove! channel))
        (recur (next tasks))))))

(defasync ^:private distribute-mult!
  [source taps]
  (try
    (loop [value (await (take! source))]
      (when (some? value)
        (let [snapshot @taps]
          (when (seq snapshot)
            (await (route-to-registrations!
                    snapshot
                    value
                    #(swap! taps dissoc %)))))
        (recur (await (take! source)))))
    (finally
      (close-registered-channels! @taps))))

(defn mult
  "Create a multiple of ``channel``.

  Values from ``channel`` are copied to every registered tap. Values received
  when there are no taps are dropped. The source channel is consumed by an
  ``asyncio`` task created on the current event loop."
  [channel]
  (let [taps (atom {})]
    {:source channel
     :taps   taps
     :task   (asyncio/create-task (distribute-mult! channel taps))}))

(defn muxch*
  "Return the source/output channel associated with a mult, pub, or mix."
  [mux]
  (or (:source mux) (:output mux)))

(defn tap
  "Copy values from ``mult`` onto ``channel``.

  By default ``channel`` closes when the mult source closes. Pass ``false`` as
  ``close?`` to leave it open. Returns ``channel``."
  ([mult channel]
   (tap mult channel true))
  ([mult channel close?]
   (swap! (:taps mult) assoc channel close?)
   channel))

(defn tap*
  "Low-level tap helper mirroring Clojure's ``Mult`` protocol method."
  [mult channel close?]
  (tap mult channel close?)
  nil)

(defn untap
  "Disconnect ``channel`` from ``mult``."
  [mult channel]
  (swap! (:taps mult) dissoc channel)
  nil)

(defn untap*
  "Low-level untap helper mirroring Clojure's ``Mult`` protocol method."
  [mult channel]
  (untap mult channel))

(defn untap-all
  "Disconnect every target channel from ``mult``."
  [mult]
  (reset! (:taps mult) {})
  nil)

(defn untap-all*
  "Low-level untap-all helper mirroring Clojure's ``Mult`` protocol method."
  [mult]
  (untap-all mult))

(defasync ^:private route-topic!
  [topics topic value]
  (let [registrations (get @topics topic)]
    (when (seq registrations)
      (await (route-to-registrations!
              registrations
              value
              #(swap! topics update topic dissoc %))))))

(defasync ^:private distribute-publication!
  [source topic-fn topics]
  (try
    (loop [value (await (take! source))]
      (when (some? value)
        (await (route-topic! topics (topic-fn value) value))
        (recur (await (take! source)))))
    (finally
      (doseq [[_topic registrations] @topics]
        (close-registered-channels! registrations)))))

(defn pub
  "Create a publication of ``channel`` partitioned by ``topic-fn``.

  The optional ``buf-fn`` argument is accepted for Clojure-shaped source
  compatibility but the current direct ``asyncio`` router does not create
  internal topic buffers."
  ([channel topic-fn]
   (pub channel topic-fn (constantly nil)))
  ([channel topic-fn buf-fn]
   (let [topics (atom {})]
     {:source   channel
      :topic-fn topic-fn
      :buf-fn   buf-fn
      :topics   topics
      :task     (asyncio/create-task
                 (distribute-publication! channel topic-fn topics))})))

(defn sub
  "Subscribe ``channel`` to ``topic`` in publication ``pub``.

  By default ``channel`` closes when the publication source closes. Pass
  ``false`` as ``close?`` to leave it open. Returns ``channel``."
  ([pub topic channel]
   (sub pub topic channel true))
  ([pub topic channel close?]
   (swap! (:topics pub) update topic #(assoc (or % {}) channel close?))
   channel))

(defn sub*
  "Low-level subscription helper mirroring Clojure's ``Pub`` protocol method."
  [pub topic channel close?]
  (sub pub topic channel close?))

(defn unsub
  "Unsubscribe ``channel`` from ``topic`` in publication ``pub``."
  [pub topic channel]
  (swap! (:topics pub) update topic dissoc channel)
  nil)

(defn unsub*
  "Low-level unsubscribe helper mirroring Clojure's ``Pub`` protocol method."
  [pub topic channel]
  (unsub pub topic channel))

(defn unsub-all
  "Unsubscribe all channels from publication ``pub``, or all channels from one
  ``topic``."
  ([pub]
   (reset! (:topics pub) {})
   {})
  ([pub topic]
   (swap! (:topics pub) dissoc topic)
   {}))

(defn unsub-all*
  "Low-level unsub-all helper mirroring Clojure's ``Pub`` protocol method."
  ([pub]
   (unsub-all pub)
   {})
  ([pub topic]
   (unsub-all pub topic)
   {}))

(defn- mix-state?
  [state mode]
  (true? (get state mode)))

(defn- mix-has-solo?
  [inputs]
  (loop [entries (seq inputs)]
    (when (seq entries)
      (let [[_channel state] (first entries)]
        (if (mix-state? state :solo)
          true
          (recur (next entries)))))))

(defn- mix-routes
  [inputs solo-mode]
  (let [has-solo? (boolean (mix-has-solo? inputs))]
    (loop [entries (seq inputs)
           routes  {}]
      (if (seq entries)
        (let [[channel state] (first entries)
              solo?          (mix-state? state :solo)
              paused?        (mix-state? state :pause)
              muted?         (mix-state? state :mute)]
          (cond
            solo?
            (recur (next entries) (assoc routes channel {:mute? false}))

            has-solo?
            (if (= :pause solo-mode)
              (recur (next entries) routes)
              (recur (next entries) (assoc routes channel {:mute? true})))

            paused?
            (recur (next entries) routes)

            :else
            (recur (next entries) (assoc routes channel {:mute? muted?}))))
        routes))))

(defn- mix-ports
  [routes change]
  (loop [channels (seq (keys routes))
         ports    [change]]
    (if (seq channels)
      (recur (next channels) (conj ports (first channels)))
      ports)))

(defn- signal-mix!
  [mix]
  (offer! (:change mix) true)
  false)

(defn- merge-mix-state
  [current updates]
  (loop [entries (seq updates)
         state   current]
    (if (seq entries)
      (let [[k v] (first entries)]
        (recur (next entries) (assoc state k v)))
      state)))

(defasync ^:private distribute-mix!
  [mix]
  (let [output    (:output mix)
        inputs    (:inputs mix)
        mode      (:solo-mode mix)
        change    (:change mix)]
    (loop []
      (let [routes          (mix-routes @inputs @mode)
            [value source]  (await (alts! (mix-ports routes change)
                                          :priority true))]
        (cond
          (identical? source change)
          (recur)

          (nil? value)
          (do
            (swap! inputs dissoc source)
            (recur))

          (:mute? (get routes source))
          (recur)

          (await (put! output value))
          (recur)

          :else
          nil)))))

(defn mix
  "Create a mix of input channels which will be put on ``out``.

  Inputs are added with ``admix`` or ``toggle`` and removed with ``unmix`` or
  ``unmix-all``. Channel state maps support Clojure's ``:solo``, ``:mute``,
  and ``:pause`` flags. The router task is owned by the current event loop."
  [out]
  (let [mix {:output    out
             :inputs    (atom {})
             :solo-mode (atom :mute)
             :change    (chan (sliding-buffer 1))}]
    (assoc mix :task (asyncio/create-task (distribute-mix! mix)))))

(defn admix
  "Add ``channel`` as an input to ``mix``."
  [mix channel]
  (swap! (:inputs mix) update channel #(or % {}))
  (signal-mix! mix)
  true)

(defn admix*
  "Low-level admix helper mirroring Clojure's ``Mix`` protocol method."
  [mix channel]
  (admix mix channel)
  true)

(defn unmix
  "Remove ``channel`` as an input from ``mix``."
  [mix channel]
  (swap! (:inputs mix) dissoc channel)
  (signal-mix! mix)
  true)

(defn unmix*
  "Low-level unmix helper mirroring Clojure's ``Mix`` protocol method."
  [mix channel]
  (unmix mix channel)
  true)

(defn unmix-all
  "Remove all inputs from ``mix``."
  [mix]
  (reset! (:inputs mix) {})
  (signal-mix! mix)
  true)

(defn unmix-all*
  "Low-level unmix-all helper mirroring Clojure's ``Mix`` protocol method."
  [mix]
  (unmix-all mix)
  true)

(defn toggle
  "Merge channel state updates into ``mix``.

  ``state-map`` maps channels to maps containing any of ``:solo``, ``:mute``,
  or ``:pause`` boolean flags. Supplying a channel not already in the mix adds
  it with the supplied state."
  [mix state-map]
  (swap! (:inputs mix)
         (fn [inputs]
           (loop [updates (seq state-map)
                  inputs  inputs]
             (if (seq updates)
               (let [[channel state] (first updates)]
                 (recur (next updates)
                        (assoc inputs channel
                               (merge-mix-state
                                (get inputs channel {})
                                state))))
               inputs))))
  (signal-mix! mix)
  true)

(defn toggle*
  "Low-level toggle helper mirroring Clojure's ``Mix`` protocol method."
  [mix state-map]
  (toggle mix state-map)
  true)

(defn solo-mode
  "Set ``mix`` solo mode to ``:mute`` or ``:pause``."
  [mix mode]
  (when-not (contains? #{:mute :pause} mode)
    (throw (ex-info "solo-mode expects :mute or :pause" {:mode mode})))
  (reset! (:solo-mode mix) mode)
  (signal-mix! mix)
  true)

(defn solo-mode*
  "Low-level solo-mode helper mirroring Clojure's ``Mix`` protocol method."
  [mix mode]
  (solo-mode mix mode)
  true)

(defn timeout
  "Create a channel that closes after ``delay-ms`` milliseconds."
  [delay-ms]
  (concurrent/timeout delay-ms))

(defn pipe
  "Forward values from ``from`` to ``to`` in a caller-owned task.

  ``:close?`` defaults to ``true`` and maps to
  ``basilisp.concurrent/pipe!``'s ``:close-output`` option."
  [from to & {:keys [close?] :or {close? true}}]
  (concurrent/pipe! from to :close-output close?))

(defn pipeline
  "Run a synchronous transducer over channel values with bounded parallelism.

  The argument order follows ``clojure.core.async/pipeline``:
  ``parallelism``, output channel, transducer, input channel. ``:close?`` maps
  to ``:close-output`` and ``:ex-handler`` maps to ``:on-error``."
  [parallelism to xform from & {:keys [close? ex-handler]
                                :or {close? true}}]
  (concurrent/pipeline! parallelism from to xform
                        :close-output close?
                        :on-error ex-handler))

(defn pipeline-blocking
  "Run a blocking synchronous transducer over channel values with bounded
  parallelism.

  This shares BaisiLisp's worker-thread pipeline runtime with ``pipeline``."
  ([parallelism to xform from]
   (pipeline-blocking parallelism to xform from true nil))
  ([parallelism to xform from close?]
   (pipeline-blocking parallelism to xform from close? nil))
  ([parallelism to xform from close? ex-handler]
   (concurrent/pipeline! parallelism from to xform
                         :close-output close?
                         :on-error ex-handler)))

(defn pipeline-async
  "Run callback-shaped async work over channel values with bounded parallelism.

  ``af`` receives an input value and a result channel. It should arrange to put
  zero or more results on that channel and close it. Results are emitted to
  ``to`` in source order. ``close?`` controls whether ``to`` closes when the
  source is drained."
  ([parallelism to af from]
   (pipeline-async parallelism to af from true))
  ([parallelism to af from close?]
   (concurrent/pipeline-async! parallelism from to af
                               :close-output close?)))

(defasync ^:private map-channel-values!
  [f channels output]
  (try
    (when (seq channels)
      (loop []
        (let [tasks  (doall (basilisp.core/map #(asyncio/create-task (take! %))
                                               channels))
              values (await (apply asyncio/gather tasks))]
          (when-not (some nil? values)
            (when (await (put! output (apply f values)))
              (recur))))))
    (finally
      (close! output))))

(defn map
  "Return a channel containing ``(apply f values)`` across one value from each
  channel in ``channels``. The output closes when any source closes."
  ([f channels]
   (map f channels nil))
  ([f channels buf-or-n]
   (let [output (chan buf-or-n)]
     (asyncio/create-task (map-channel-values! f channels output))
     output)))

(defasync ^:private partition-values!
  [n channel output]
  (try
    (loop [acc   []
           value (await (take! channel))]
      (if (some? value)
        (let [next-acc (conj acc value)]
          (if (= n (count next-acc))
            (when (await (put! output next-acc))
              (recur [] (await (take! channel))))
            (recur next-acc (await (take! channel)))))
        (when (seq acc)
          (await (put! output acc)))))
    (finally
      (close! output))))

(defn partition
  "Return a channel containing vectors of up to ``n`` consecutive values from
  ``channel``. A final partial partition is emitted before close."
  ([n channel]
   (partition n channel nil))
  ([n channel buf-or-n]
   (when-not (pos-int? n)
     (throw (ex-info "partition expects a positive integer size" {:n n})))
   (let [output (chan buf-or-n)]
     (asyncio/create-task (partition-values! n channel output))
     output)))

(defasync ^:private partition-by-values!
  [f channel output]
  (try
    (loop [acc       []
           prior-key no-prior-value
           value     (await (take! channel))]
      (if (some? value)
        (let [current-key (f value)]
          (cond
            (identical? prior-key no-prior-value)
            (recur [value] current-key (await (take! channel)))

            (= prior-key current-key)
            (recur (conj acc value) prior-key (await (take! channel)))

            (await (put! output acc))
            (recur [value] current-key (await (take! channel)))

            :else
            nil))
        (when (seq acc)
          (await (put! output acc)))))
    (finally
      (close! output))))

(defn partition-by
  "Return a channel containing vectors of consecutive values from ``channel``
  grouped while ``(f value)`` remains equal."
  ([f channel]
   (partition-by f channel nil))
  ([f channel buf-or-n]
   (let [output (chan buf-or-n)]
     (asyncio/create-task (partition-by-values! f channel output))
     output)))

(defasync ^:private unique-values!
  [channel output]
  (try
    (loop [prior no-prior-value
           value (await (take! channel))]
      (when (some? value)
        (if (and (not (identical? prior no-prior-value))
                 (= prior value))
          (recur prior (await (take! channel)))
          (when (await (put! output value))
            (recur value (await (take! channel)))))))
    (finally
      (close! output))))

(defn unique
  "Return a channel suppressing consecutive duplicate values from ``channel``."
  ([channel]
   (unique channel nil))
  ([channel buf-or-n]
   (let [output (chan buf-or-n)]
     (asyncio/create-task (unique-values! channel output))
     output)))
