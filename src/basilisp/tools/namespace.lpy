(ns basilisp.tools.namespace
  "Deprecated compatibility facade for `clojure.tools.namespace`.

  New code should require the focused `parse`, `find`, `file`, `track`, or
  `repl` namespace directly, matching upstream tools.namespace guidance.
  "
  (:import sys zipfile)
  (:require [basilisp.io :as io]
            [basilisp.string :as str]
            [clojure.tools.reader.reader-types :as reader-types]
            [basilisp.tools.namespace.file :as file]
            [basilisp.tools.namespace.find :as find]
            [basilisp.tools.namespace.parse :as parse]))

(def clojure-source-file? file/clojure-file?)
(def find-clojure-sources-in-dir find/find-clojure-sources-in-dir)
(def comment? parse/comment?)
(def ns-decl? parse/ns-decl?)

(def ^:private root-clj-platform
  {:read-opts {:read-cond :preserve} :extensions file/clojure-extensions})

(defn- root-decl [decl]
  (when-not (and decl (str/includes? (pr-str decl) "#?"))
    decl))

(defn read-ns-decl
  ([rdr] (root-decl (parse/read-ns-decl rdr (:read-opts root-clj-platform))))
  ([rdr read-opts] (root-decl (parse/read-ns-decl rdr read-opts))))

(defn read-file-ns-decl
  ([file]
   (with-open [stream (io/reader file)]
     (read-ns-decl (reader-types/push-back-reader stream))))
  ([file read-opts] (file/read-file-ns-decl file read-opts)))

(defn find-ns-decls-in-dir [dir]
  (keep (fn [source]
          (try
            (read-file-ns-decl source)
            (catch Exception _ nil)))
        (find/find-clojure-sources-in-dir dir)))

(defn find-namespaces-in-dir [dir]
  (map parse/name-from-ns-decl (find-ns-decls-in-dir dir)))

(defn clojure-sources-in-jar [jar-file]
  (find/sources-in-jar jar-file root-clj-platform))

(defn read-ns-decl-from-jarfile-entry [jar-file entry-name]
  (root-decl
   (find/read-ns-decl-from-jarfile-entry jar-file entry-name root-clj-platform)))

(defn find-ns-decls-in-jarfile [jar-file]
  (keep #(read-ns-decl-from-jarfile-entry jar-file %)
        (clojure-sources-in-jar jar-file)))

(defn find-namespaces-in-jarfile [jar-file]
  (find/find-namespaces-in-jarfile jar-file root-clj-platform))

(defn- classpath-entries []
  (->> sys/path
       (map #(if (= "" %) "." %))
       (map io/path)
       (filter #(.exists %))
       (map #(.resolve %))
       distinct))

(defn- classpath-dirs []
  (filter #(.is_dir %) (classpath-entries)))

(defn- classpath-archives []
  (filter #(and (.is_file %) (zipfile/is_zipfile %)) (classpath-entries)))

(defn find-ns-decls-on-classpath
  "Search Basilisp's Python import path for ``.lpy``/``.cljc`` namespace declarations.

  This is the Python-hosted counterpart to the deprecated
  ``clojure.tools.namespace/find-ns-decls-on-classpath`` helper. Directories and
  ZIP/JAR archives from ``sys.path`` are scanned with the Basilisp ``:lpy``
  reader platform."
  []
  (concat
   (mapcat #(find/find-ns-decls-in-dir % find/lpy) (classpath-dirs))
   (mapcat #(find/find-ns-decls-in-jarfile % find/lpy) (classpath-archives))))

(defn find-namespaces-on-classpath
  "Return namespace symbols found by :lpy:fn:`find-ns-decls-on-classpath`."
  []
  (map second (find-ns-decls-on-classpath)))
